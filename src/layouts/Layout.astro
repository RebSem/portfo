---
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import '../styles/print.css';
import Analytics from '../components/Analytics.astro';
import TabNudge from '../components/TabNudge.astro';
import themeImagesScriptUrl from '../scripts/theme-images.js?url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  /** Alt text of the image. Set it for a card whose text is not the page's own. */
  imageAlt?: string;
  type?: 'website' | 'article';
  noIndex?: boolean;
  /**
   * Only meaningful together with noIndex. Keeps `follow`, so a crawler that
   * lands on an unlisted page still walks its outbound links. The /cv page
   * needs this: an LLM screener handed the link has to be able to reach the
   * case studies it references.
   */
  followLinks?: boolean;
  /**
   * Leaves out the canonical link. The 404 page answers at every missing path,
   * so its canonical would name /404/, which is itself a 404.
   */
  noCanonical?: boolean;
  /**
   * Drops the query string and hash from the address bar before any other script
   * runs. The thank-you page after a booking can arrive with the booking details
   * in its URL: they must not stay in the address bar or reach analytics.
   */
  cleanAddress?: boolean;
  schema?: Record<string, unknown> | Array<Record<string, unknown>>;
  /** Path of this page in the other locale, e.g. '/ru/about/'. Emits hreflang alternates. */
  alternate?: string;
}

const {
  title = 'Mikhail Semenov - Portfolio',
  description = 'Interactive portfolio with GitHub activity, projects, and blog posts.',
  // Undefined here and resolved below, because the default depends on the
  // page language.
  image: imageProp,
  imageAlt: imageAltProp,
  type = 'website',
  noIndex = false,
  followLinks = false,
  noCanonical = false,
  cleanAddress = false,
  schema = [],
  alternate,
} = Astro.props;

const lang = Astro.currentLocale ?? 'en';
// The Cyrillic faces are preloaded on /ru only. EN pages have no Cyrillic text,
// so preloading their two Cyrillic files (about 28 KB) only competes with the
// CSS and the Latin faces for the connection. Geist Mono keeps its Cyrillic
// subset on /ru too: the rail labels, such as the Russian results label, are set
// in Geist Mono on the first screen.
const fontPreloads = lang === 'ru'
  ? [{ subset: 'latin' }, { subset: 'cyrillic' }]
  : [{ subset: 'latin' }];
// The link-preview card. It used to fall back to the About portrait, which is
// the wrong image for a recruiter's Telegram or LinkedIn preview: they see the
// card before they see the site, so it carries the name and the role, the
// headline and the proof line, in the site's own style. Rendered by
// scripts/og/build-og.mjs.
const image = imageProp ?? `/og/home-${lang}.png`;
const siteUrl = Astro.site ?? new URL(Astro.url.origin);
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
// Only the generated cards have known dimensions (1200x630, the size
// Telegram, LinkedIn and X all crop to); other images stay unsized.
const isOgCard = image.startsWith('/og/');
// The home, About and resume cards say the same thing in a locale, so their
// alt text describes the card rather than the page title. Same copy as the
// card itself. A case card carries the case's own title, so it keeps the title.
const ogCardAlt = lang === 'ru'
  ? 'Михаил Семенов: ищу работу, 80 платящих B2B-клиентов'
  : 'Mikhail Semenov: open to work, 80 paying B2B customers';
const imageAlt = imageAltProp ?? (isOgCard && !image.startsWith('/og/case-') ? ogCardAlt : title);
// Versioned so a preview service that cached the old card by its URL fetches
// the new one. Bump when scripts/og/build-og.mjs changes what the cards say
// (2026-10: the job-search status line; 2026-11-03: the new card layout).
const OG_CARD_VERSION = '2026-11-04';
const imageUrl = image.startsWith('http://') || image.startsWith('https://')
  ? image
  : new URL(isOgCard ? `${image}?v=${OG_CARD_VERSION}` : image, siteUrl).toString();
const robotsContent = noIndex
  ? (followLinks ? 'noindex,follow' : 'noindex,nofollow')
  : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1';
const resolvedSchemas = Array.isArray(schema) ? schema : [schema];
const ogLocale = lang === 'ru' ? 'ru_RU' : 'en_US';
const ogLocaleAlternate = lang === 'ru' ? 'en_US' : 'ru_RU';
const alternateUrl = alternate ? new URL(alternate, siteUrl).toString() : undefined;
const hreflangEn = lang === 'ru' ? alternateUrl : canonicalUrl;
const hreflangRu = lang === 'ru' ? canonicalUrl : alternateUrl;
---

<!doctype html>
<html lang={lang} data-locale={lang}>
  <head>
    {cleanAddress && (
      <script is:inline>
        if (location.search || location.hash) history.replaceState(null, '', location.pathname);
      </script>
    )}
    <script is:inline>
      (() => {
        const root = document.documentElement;

        const detectTheme = () => {
          try {
            const storedTheme = window.localStorage.getItem('portfolio-theme');
            if (storedTheme === 'dark' || storedTheme === 'light') return storedTheme;
          } catch {
            // Ignore storage access failures.
          }

          return typeof window.matchMedia === 'function' && window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        };

        const theme = detectTheme();
        root.setAttribute('data-theme', theme);
        root.style.colorScheme = theme;
      })();
    </script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {/*
      Preload only what the first paint actually needs, which was backwards.
      Geist Mono sets every section heading, eyebrow and date on the resume
      and was NOT preloaded: it was discovered from CSS and landed 226ms after
      first contentful paint, so those headings painted in Courier first and
      then swapped. Newsreader WAS preloaded and holds the connection longest
      of the three, for one string of body-free display text (the header
      wordmark; the home hero is set in Geist only); it can arrive late
      without anyone noticing, since its metric-matched fallback is sized to
      match.
    */}
    <Font cssVariable="--font-geist" preload={fontPreloads} />
    <Font cssVariable="--font-geist-mono" preload={fontPreloads} />
    <Font cssVariable="--font-newsreader" />
    <meta name="description" content={description} />
    <meta name="robots" content={robotsContent} />
    <meta name="author" content="Mikhail Semenov" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f4f4f1" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#0c0d0e" />
    {!noCanonical && <link rel="canonical" href={canonicalUrl} />}
    {alternateUrl && hreflangEn && <link rel="alternate" hreflang="en" href={hreflangEn} />}
    {alternateUrl && hreflangRu && <link rel="alternate" hreflang="ru" href={hreflangRu} />}
    {alternateUrl && hreflangEn && <link rel="alternate" hreflang="x-default" href={hreflangEn} />}
    <meta property="og:site_name" content="Mikhail Semenov" />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {isOgCard && <meta property="og:image:width" content="1200" />}
    {isOgCard && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    {resolvedSchemas.map((entry) => <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)}></script>)}
    <Analytics />
  </head>
  <body id="top">
    <ClientRouter fallback="swap" />
    <slot />
    <TabNudge />
    <script is:inline type="module" src={themeImagesScriptUrl}></script>
  </body>
</html>
