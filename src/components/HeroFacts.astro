---
import { uiCopy } from '../data/site-content';
import type { Locale } from '../types/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

{/* The four facts a recruiter screens on. The home hero and the About header
    both render them from uiCopy.home.facts, so the wording and the layout
    cannot drift apart. */}
<dl class="hero-facts-list">
  {uiCopy.home.facts.map((fact) => (
    <div>
      <dt>{fact.label[locale]}</dt>
      <dd>{fact.value[locale]}</dd>
    </div>
  ))}
</dl>

<style>
  /* One line of four facts on a laptop, each as wide as its value, spread
     over the column; a 2x2 grid once the column is too narrow for that. */
  .hero-facts-list {
    display: flex;
    justify-content: space-between;
    /* The page gutter now takes 60-90px more from the column at 1181-1440,
       and wider minimum gaps wrapped the English values there. space-between
       spreads whatever room is left, so the visible gaps stay open. */
    gap: 0.9rem 0.6rem;
    margin: 0;
  }

  .hero-facts-list div {
    display: grid;
    align-content: start;
    gap: 0.2rem;
    min-width: 0;
  }

  /* Sentence case in Geist: the mono caps are kept for the rail labels only. */
  .hero-facts-list dt {
    font-size: 0.8125rem;
    line-height: 1.35;
    color: var(--text-muted);
  }

  /* In the 2x2 grid a value can wrap to two lines; balanced, they come out
     even instead of leaving a short tail ("relocation" on its own). */
  .hero-facts-list dd {
    margin: 0;
    font-size: 0.925rem;
    line-height: 1.4;
    letter-spacing: -0.012em;
    color: var(--foreground);
    text-wrap: balance;
  }

  /* The role value is the longest; on one row it keeps its own line so the
     shorter facts, not the role, give up the room. */
  .hero-facts-list div:first-child dd {
    white-space: nowrap;
  }

  @media (max-width: 1180px) {
    .hero-facts-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem 1.5rem;
    }
  }

  @media (max-width: 720px) {
    /* The role value is the longest: a wider first column keeps it on one
       line, so the longer value does not push the first screen down. */
    .hero-facts-list {
      grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
      gap: 0.75rem 1.25rem;
    }

    .hero-facts-list div:first-child dd {
      white-space: normal;
    }
  }
</style>
