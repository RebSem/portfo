---
import { heroDisplayName, telegramUrl, uiCopy } from '../data/site-content';
import type { Locale } from '../types/content';
import SocialLinks from './SocialLinks.astro';

interface Props {
  locale: Locale;
  caseHref: string;
}

const { locale, caseHref } = Astro.props;
const copy = uiCopy.home;

// The standfirst is balanced, and a balanced line happily breaks a compound
// word at its hyphen ("B2B-" / "клиентов"). Same fix as nb() in
// CvDocument.astro: hyphenated tokens go in a nowrap span, the text itself
// is untouched.
const HYPHENATED = /[\p{L}\p{N}]-[\p{L}\p{N}]/u;
const chunks = (value: string) => value.split(/(\s+)/);
---

{/*
  One column again, set like a magazine opener: byline, a headline that
  carries the page on its own, the standfirst, the one action. The product
  screenshot that shared this screen from 2026-10-19 is gone: at a glance
  it read as decoration to the people this page is for, and the claim
  needs the room more than the picture did. The results it stood for sit
  right below, in the band (HomeResults.astro).
*/}
<section class="home-intro" aria-labelledby="home-title" data-analytics-placement="hero">
  <p class="hero-identity ed-rise">
    <span>{heroDisplayName[locale]}</span>
    <span class="hero-identity-divider" aria-hidden="true">/</span>
    <span class="hero-role">Product Manager</span>
  </p>

  <h1 id="home-title">
    <span class="ed-rise ed-rise-1">{copy.title[locale]}</span>
    <span class="hero-focus ed-rise ed-rise-2">{copy.titleFocus[locale]}</span>
  </h1>

  <p class="hero-proof ed-rise ed-rise-3">
    {chunks(copy.proofIntro[locale]).map((c) => (HYPHENATED.test(c) ? <span class="nb">{c}</span> : c))}
    <strong>{chunks(copy.proofResult[locale]).map((c) => (HYPHENATED.test(c) ? <span class="nb">{c}</span> : c))}</strong>
  </p>

  <div class="hero-cta-row ed-rise ed-rise-4">
    <a class="cta-button cta-primary" href={telegramUrl} target="_blank" rel="noreferrer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 11l16 -8l-4 18l-5 -4l-3 3l1 -5l8 -7" />
      </svg>
      {copy.heroCtaPrimary[locale]}
    </a>
    <a class="cta-button cta-secondary" href={caseHref} aria-label={copy.heroCaseLabel[locale]}>
      {copy.heroCtaSecondary[locale]}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14" /><path d="M13 6l6 6l-6 6" />
      </svg>
    </a>
  </div>

  {/* The availability line: the status in the rail, the four facts a
      recruiter screens on beside it. The status dot is static on purpose. */}
  <div class="hero-facts ed-row ed-rise ed-rise-5">
    <p class="hero-status">
      <span class="hero-status-dot" aria-hidden="true"></span>
      {copy.heroStatusShort[locale]}
    </p>
    <div class="hero-facts-body">
      <dl class="hero-facts-list">
        {copy.facts.map((fact) => (
          <div>
            <dt>{fact.label[locale]}</dt>
            <dd>{fact.value[locale]}</dd>
          </div>
        ))}
      </dl>
      <SocialLinks className="social-links hero-social-links" hideTelegram label={copy.heroSocialAria[locale]} />
    </div>
  </div>
</section>

<style>
  .home-intro {
    padding-top: clamp(2.25rem, 6.5vh, 4.75rem);
  }

  .hero-identity {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.7rem;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .hero-identity-divider {
    color: color-mix(in oklab, var(--foreground) 30%, var(--background-alt));
    font-weight: 400;
  }

  .hero-role {
    color: color-mix(in oklab, var(--foreground) 62%, var(--background-alt));
    font-weight: 400;
  }

  /* The headline sets the scale for the page. Sized in vw below ~960px so
     both lines hold in both locales down to a 360px phone ("Запускаю и
     развиваю" is the longest line); capped at 5.6rem on wide screens. */
  h1 {
    margin-top: clamp(1.1rem, 2.2vw, 1.9rem);
    font-size: clamp(1.875rem, 9.1vw, 5.6rem);
    font-weight: 600;
    letter-spacing: -0.052em;
    line-height: 0.99;
  }

  h1 > span {
    display: block;
  }

  .hero-focus {
    color: var(--accent-text);
  }

  .hero-proof {
    margin-top: clamp(1.4rem, 2.6vw, 2.15rem);
    max-width: 40rem;
    font-size: clamp(1.0625rem, 0.55vw + 0.88rem, 1.3rem);
    line-height: 1.5;
    letter-spacing: -0.008em;
    color: color-mix(in oklab, var(--foreground) 66%, var(--background-alt));
    text-wrap: balance;
  }

  /* Balance leaves "80 платящих" alone on a phone line once the compound
     word is held together; the result line only needs a decent last line. */
  .hero-proof strong {
    display: block;
    color: var(--foreground);
    font-weight: 500;
    text-wrap: pretty;
  }

  .nb {
    white-space: nowrap;
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-top: clamp(1.6rem, 2.8vw, 2.35rem);
  }

  .hero-cta-row .cta-button {
    min-height: 3.1rem;
    height: auto;
    padding: 0.9rem 1.35rem;
    border-radius: 0.8rem;
    line-height: 1.2;
  }

  /* --- Availability line ----------------------------------------------- */

  .hero-facts {
    margin-top: clamp(2.5rem, 5.2vw, 4.25rem);
    padding-bottom: clamp(1.2rem, 1.8vw, 1.5rem);
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    align-self: start;
    gap: 0.55rem;
    margin: 0;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--accent-text);
  }

  /* The halo is static: it marks the status without pulsing. The margin
     keeps its outer edge on the page's left line, not past it. */
  .hero-status-dot {
    width: 7px;
    height: 7px;
    flex: none;
    margin-left: 4px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 0 4px color-mix(in oklab, var(--accent) 16%, transparent);
  }

  .hero-facts-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 1rem 2rem;
  }

  .hero-facts-list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem 1.75rem;
    margin: 0;
  }

  .hero-facts-list div {
    display: grid;
    align-content: start;
    gap: 0.25rem;
  }

  .hero-facts-list dt {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hero-facts-list dd {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--foreground);
  }

  .hero-facts :global(.hero-social-links) {
    gap: 0;
    margin: -0.55rem -0.6rem 0 0;
  }

  .hero-facts :global(.social-link) {
    width: 2.5rem;
    height: 2.5rem;
    color: color-mix(in oklab, var(--foreground) 70%, transparent);
  }

  .hero-facts :global(.social-link svg) {
    width: 20px;
    height: 20px;
  }

  @media (max-width: 1180px) {
    .hero-facts-body {
      grid-template-columns: minmax(0, 1fr);
    }

    .hero-facts :global(.hero-social-links) {
      display: none;
    }
  }

  @media (max-width: 720px) {
    .home-intro {
      padding-top: 0.6rem;
    }

    .hero-facts-list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.85rem 1.25rem;
    }

    .hero-cta-row .cta-button {
      padding-inline: 0.8rem;
      font-size: 0.9rem;
    }
  }

  @media (max-width: 480px) {
    .hero-cta-row .cta-button {
      flex: 1 1 auto;
    }
  }

  @media (max-width: 360px) {
    .hero-identity {
      gap: 0.25rem 0.5rem;
      font-size: 0.875rem;
    }

    .hero-cta-row .cta-button {
      font-size: 0.8125rem;
    }

    .hero-facts-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
