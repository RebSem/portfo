---
import { heroDisplayName, telegramUrl, uiCopy } from '../data/site-content';
import type { Locale } from '../types/content';
import SocialLinks from './SocialLinks.astro';

interface Props {
  locale: Locale;
  caseHref: string;
}

const { locale, caseHref } = Astro.props;
const copy = uiCopy.home;
---

<section class="home-intro" aria-labelledby="home-title">
  <p class="hero-identity">
    <span>{heroDisplayName[locale]}</span>
    <span class="hero-identity-divider" aria-hidden="true">/</span>
    <span class="hero-role">Product Manager</span>
  </p>

  <h1 id="home-title">
    <span>{copy.title[locale]}</span>
    <span class="hero-focus">{copy.titleFocus[locale]}</span>
  </h1>

  <p class="hero-proof">
    {copy.proofIntro[locale]}
    <strong>{copy.proofResult[locale]}</strong>
  </p>

  <div class="hero-cta-row">
    <a class="cta-button cta-primary" href={telegramUrl} target="_blank" rel="noreferrer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 11l16 -8l-4 18l-5 -4l-3 3l1 -5l8 -7" />
      </svg>
      {copy.heroCtaPrimary[locale]}
    </a>
    <a class="cta-button cta-secondary" href={caseHref} aria-label={copy.heroCaseLabel[locale]}>
      {copy.heroCtaSecondary[locale]}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14" /><path d="M13 6l6 6l-6 6" />
      </svg>
    </a>
  </div>

  <div class="hero-footer">
    <p class="hero-availability">
      <span class="hero-status"><span class="hero-status-dot" aria-hidden="true"></span>{copy.heroStatus[locale]}</span>
      <span class="hero-format">{copy.workFormat[locale]}</span>
    </p>
    <SocialLinks className="social-links hero-social-links" hideTelegram label={copy.heroSocialAria[locale]} />
  </div>
</section>

<style>
  .home-intro {
    padding-block: clamp(2.25rem, 5vw, 4.25rem) 1.5rem;
  }

  .hero-identity {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.75rem;
    font-size: 0.95rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .hero-identity-divider {
    color: color-mix(in oklab, var(--foreground) 35%, var(--background-alt));
    font-weight: 400;
  }

  .hero-role {
    color: color-mix(in oklab, var(--foreground) 65%, var(--background-alt));
    font-weight: 400;
  }

  h1 {
    margin-top: 1.65rem;
    max-width: 18ch;
    font-size: clamp(2.125rem, 5.7vw + 0.5rem, 5rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.07;
  }

  h1 > span {
    display: block;
  }

  .hero-focus {
    color: var(--accent-text);
  }

  .hero-proof {
    margin-top: 1.85rem;
    max-width: 42rem;
    font-size: clamp(1.0625rem, 0.65vw + 0.85rem, 1.25rem);
    line-height: 1.6;
    color: color-mix(in oklab, var(--foreground) 70%, var(--background-alt));
    text-wrap: pretty;
  }

  .hero-proof strong {
    display: block;
    color: var(--foreground);
    font-weight: 500;
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.9rem;
  }

  .hero-cta-row .cta-button {
    min-height: 3rem;
    height: auto;
    padding: 0.9rem 1.3rem;
    border-radius: 0.8rem;
    line-height: 1.2;
  }

  .hero-footer {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2.6rem;
  }

  .hero-availability {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.1rem;
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .hero-status {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--accent-text);
  }

  .hero-status-dot {
    width: 6px;
    height: 6px;
    flex: none;
    border-radius: 50%;
    background: currentColor;
  }

  .hero-format {
    color: color-mix(in oklab, var(--foreground) 65%, var(--background-alt));
  }

  .hero-footer :global(.hero-social-links) {
    gap: 0.1rem;
    margin: 0 -0.55rem 0 0;
  }

  .hero-footer :global(.social-link) {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 0.7rem;
  }

  @media (max-width: 720px) {
    /* No separate font-size here: a second clamp met the desktop one at
       60px vs 49px on the 720px boundary. The desktop formula bottoms out
       at 2.125rem, which is the phone size anyway. */
    h1 {
      max-width: 100%;
      margin-top: 1.3rem;
      letter-spacing: -0.04em;
      line-height: 1.12;
    }

    .hero-proof {
      margin-top: 1.4rem;
    }

    .hero-cta-row {
      margin-top: 1.5rem;
    }

    .hero-cta-row .cta-button {
      padding-inline: 0.75rem;
      font-size: 0.875rem;
    }

    .hero-footer {
      align-items: flex-start;
      margin-top: 1.75rem;
      gap: 0.75rem;
    }

    .hero-availability {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.3rem;
    }
  }

  /* Phones: the two CTAs no longer fit one row below ~400px, so let them
     fill their rows instead of stacking ragged. Above this they sit side by
     side at natural width. */
  @media (max-width: 480px) {
    .hero-cta-row .cta-button {
      flex: 1 1 auto;
    }
  }

  @media (max-width: 360px) {
    .hero-identity {
      gap: 0.25rem 0.5rem;
      font-size: 0.8125rem;
    }

    .hero-cta-row .cta-button {
      font-size: 0.8125rem;
    }
  }
</style>
