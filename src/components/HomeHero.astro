---
import { heroDisplayName, linkedinUrl, telegramUrl, uiCopy } from '../data/site-content';
import { buildIntroMailto } from '../lib/intro-mail';
import { chunks, HYPHENATED } from '../lib/nb';
import type { Locale } from '../types/content';
import HeroFacts from './HeroFacts.astro';
import SocialLinks from './SocialLinks.astro';

interface Props {
  locale: Locale;
  caseHref: string;
}

const { locale, caseHref } = Astro.props;
const copy = uiCopy.home;

// The standfirst is balanced, and a balanced line happily breaks a compound
// word at its hyphen ("B2B-" / "клиентов"), so hyphenated tokens go in a
// nowrap span (src/lib/nb.ts).
---

{/*
  One column again, set like a magazine opener: byline, a headline that
  carries the page on its own, the standfirst, the one action. The product
  screenshot that shared this screen from 2026-10-19 is gone: at a glance
  it read as decoration to the people this page is for, and the claim
  needs the room more than the picture did. The results it stood for sit
  right below, in the band (HomeResults.astro).

  Nothing in the opener is hidden at load: the headline is the page's LCP
  element and paints with the first frame, the status and the facts too.
  The only motion is the hairlines drawing in (.ed-draw in global.css).
*/}
<section class="home-intro" aria-labelledby="home-title" data-analytics-placement="hero">
  <p class="hero-identity">
    <span>{heroDisplayName[locale]}</span>
    <span class="hero-identity-divider" aria-hidden="true">/</span>
    <span class="hero-role" lang={locale === 'ru' ? 'en' : undefined}>{copy.heroRole[locale]}</span>
  </p>

  <h1 id="home-title">
    <span>{copy.title[locale]}</span>
    <span class="hero-focus">{copy.titleFocus[locale]}</span>
  </h1>

  <p class="hero-proof">
    {chunks(copy.proofIntro[locale]).map((c) => (HYPHENATED.test(c) ? <span class="nb">{c}</span> : c))}
    <strong>{chunks(copy.proofResult[locale]).map((c) => (HYPHENATED.test(c) ? <span class="nb">{c}</span> : c))}</strong>
  </p>

  {/* The ways to write sit with the actions: Telegram as the button, the
      profiles and the email as quiet icons after it. On phones the icons
      drop out and the line under the buttons (.hero-alt) carries Email and
      LinkedIn instead, so a recruiter without Telegram still has a way in. */}
  <div class="hero-cta-row">
    <a class="cta-button cta-primary" href={telegramUrl} target="_blank" rel="noreferrer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 11l16 -8l-4 18l-5 -4l-3 3l1 -5l8 -7" />
      </svg>
      {copy.heroCtaPrimary[locale]}
    </a>
    <a class="cta-button cta-secondary" href={caseHref} aria-label={copy.heroCaseLabel[locale]}>
      {copy.heroCtaSecondary[locale]}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14" /><path d="M13 6l6 6l-6 6" />
      </svg>
    </a>
    <SocialLinks
      className="social-links hero-social-links"
      hideTelegram
      mailHref={buildIntroMailto(locale)}
      label={copy.heroSocialAria[locale]}
    />
  </div>

  <p class="hero-alt">
    {copy.heroAlt.lead[locale]}
    <a href={buildIntroMailto(locale)}>{copy.heroAlt.email[locale]}</a>
    <span class="hero-alt-sep" aria-hidden="true">·</span>
    <a href={linkedinUrl} target="_blank" rel="noreferrer">{copy.heroAlt.linkedin[locale]}</a>
  </p>

  {/* The availability line: the status as a badge in the rail, the four
      facts a recruiter screens on beside it. The status dot is static on
      purpose. */}
  <div class="hero-facts ed-row ed-draw">
    <p class="hero-status">
      <span class="hero-status-dot" aria-hidden="true"></span>
      {copy.heroStatusShort[locale]}
    </p>
    <HeroFacts locale={locale} />
  </div>
</section>

<style>
  /* The opener's vertical rhythm follows the viewport height as well as
     the width, so the results band under it clears the fold on a 13-inch
     laptop (about 1440x780 of usable page) and still breathes at 900px. */
  .home-intro {
    padding-top: clamp(1.75rem, 5.5vh, 4.25rem);
  }

  .hero-identity {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.7rem;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .hero-identity-divider {
    color: color-mix(in oklab, var(--foreground) 30%, var(--background-alt));
    font-weight: 400;
  }

  .hero-role {
    color: color-mix(in oklab, var(--foreground) 64%, var(--background-alt));
    font-weight: 400;
  }

  /* The headline sets the scale for the page. Sized in vw below ~960px so
     both lines hold in both locales down to a 360px phone ("Запускаю и
     развиваю" is the longest line), in vh on short laptop screens, and
     capped at 5.6rem. A touch under semibold with slightly looser
     tracking: at this size 600 and -0.05em read dense. */
  h1 {
    margin-top: clamp(1rem, 2.4vh, 1.75rem);
    font-size: clamp(1.875rem, min(9.1vw, 11.6vh), 5.6rem);
    font-weight: 580;
    letter-spacing: -0.046em;
    line-height: 0.99;
  }

  h1 > span {
    display: block;
  }

  .hero-focus {
    color: var(--accent-text);
  }

  .hero-proof {
    margin-top: clamp(1.25rem, 3vh, 2rem);
    max-width: 40rem;
    font-size: clamp(1.0625rem, 0.55vw + 0.88rem, 1.3rem);
    line-height: 1.5;
    letter-spacing: -0.008em;
    color: color-mix(in oklab, var(--foreground) 68%, var(--background-alt));
    text-wrap: balance;
  }

  /* Balance leaves "80 платящих" alone on a phone line once the compound
     word is held together; the result line only needs a decent last line. */
  .hero-proof strong {
    display: block;
    color: var(--foreground);
    font-weight: 500;
    text-wrap: pretty;
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem;
    margin-top: clamp(1.5rem, 3.4vh, 2.25rem);
  }

  .hero-cta-row .cta-button {
    min-height: 3.1rem;
    height: auto;
    padding: 0.9rem 1.35rem;
    border-radius: 0.8rem;
    line-height: 1.2;
  }

  .hero-cta-row :global(.hero-social-links) {
    gap: 0;
    margin-left: 0.6rem;
  }

  .hero-cta-row :global(.social-link) {
    width: 2.75rem;
    height: 2.75rem;
    color: color-mix(in oklab, var(--foreground) 66%, transparent);
  }

  .hero-cta-row :global(.social-link svg) {
    width: 20px;
    height: 20px;
  }

  /* Shown on phones only, see the 720px block below. */
  .hero-alt {
    display: none;
  }

  /* --- Availability line ----------------------------------------------- */

  .hero-facts {
    align-items: center;
    margin-top: clamp(2rem, 5.5vh, 3.75rem);
    padding-bottom: clamp(1.1rem, 2.2vh, 1.4rem);
  }

  /* The first thing a recruiter checks, so it reads as a badge, not a line
     of text: a tinted pill with a static dot. */
  .hero-status {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: 0.5rem;
    margin: 0;
    padding: 0.38rem 0.85rem 0.38rem 0.7rem;
    border: 1px solid color-mix(in oklab, var(--accent) 34%, transparent);
    border-radius: 999px;
    background: color-mix(in oklab, var(--accent) 11%, transparent);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--accent-text);
    white-space: nowrap;
  }

  .hero-status-dot {
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
    background: currentColor;
  }

  @media (max-width: 900px) {
    .hero-facts {
      align-items: start;
    }
  }

  @media (max-width: 720px) {
    .home-intro {
      padding-top: 0.6rem;
    }

    h1 {
      margin-top: 0.85rem;
    }

    .hero-proof {
      margin-top: 1.15rem;
    }

    .hero-cta-row {
      margin-top: 1.4rem;
    }

    .hero-cta-row .cta-button {
      padding-inline: 0.8rem;
      font-size: 0.9rem;
    }

    .hero-cta-row :global(.hero-social-links) {
      display: none;
    }

    /* The line that replaces the icon row: one row of text under the
       buttons, each link 44px tall for a thumb. */
    .hero-alt {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0 0.3rem;
      margin: 0;
      font-size: 0.9rem;
      line-height: 1.3;
      color: var(--text-muted);
    }

    .hero-alt a {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      padding-inline: 0.35rem;
      text-decoration: underline;
    }

    .hero-facts {
      margin-top: 1.75rem;
    }
  }

  @media (max-width: 480px) {
    .hero-cta-row .cta-button {
      flex: 1 1 auto;
    }
  }

  @media (max-width: 360px) {
    .hero-identity {
      gap: 0.25rem 0.5rem;
      font-size: 0.875rem;
    }

    .hero-cta-row .cta-button {
      font-size: 0.8125rem;
    }
  }

  /* A 1366x768 screen leaves 657-680px of viewport once the browser chrome
     is in. Tighten the opener up to 770px of height so the results labels
     stay above the fold; a 13-inch MacBook (about 780px) keeps the full
     headline. */
  @media (min-width: 721px) and (max-height: 770px) {
    .home-intro {
      padding-top: clamp(1rem, 3vh, 2rem);
    }

    h1 {
      margin-top: 0.75rem;
      font-size: clamp(1.875rem, min(9.1vw, 10.2vh), 5.6rem);
    }

    .hero-proof {
      margin-top: 1rem;
    }

    .hero-cta-row {
      margin-top: 1.25rem;
    }

    .hero-facts {
      margin-top: 1.5rem;
      padding-bottom: 0.9rem;
    }
  }
</style>
