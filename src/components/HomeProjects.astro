---
import { getCollection } from 'astro:content';
import { projects } from '../data/projects';
import { uiCopy } from '../data/site-content';
import type { Locale } from '../types/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = uiCopy.projects;
const isRu = locale === 'ru';

// One component for both home pages: the two used to carry 150 lines of
// identical markup each, and every copy change had to be made twice.
const entries = await getCollection('projects', ({ data }) => !data.draft && data.lang === locale);
const caseHrefFor = (id: string): string | undefined => {
  const entry = entries.find((e) => e.data.projectId === id);
  if (!entry) return undefined;
  return isRu ? `/ru/projects/${entry.id}/` : `/projects/${entry.id}/`;
};

const visible = projects.filter((p) => !p.placeholder);
const featured = visible.find((p) => p.id === 'zvonobot-ai');
const workLed = visible.filter((p) => p.tier === 'work-led' && p.id !== 'zvonobot-ai');
const pets = visible
  .filter((p) => p.tier === 'pet')
  .sort((a, b) => (a.petOrder ?? 99) - (b.petOrder ?? 99));

const statusFor = (id: string) =>
  copy.statusLabel[id as keyof typeof copy.statusLabel]?.[locale];

const arrow = '<path d="M5 12h14m-7-7 7 7-7 7"/>';
const external = '<path d="M7 17 17 7M9 7h8v8"/>';
---

{/*
  A section front in three rows on the editorial grid: the lead story
  (the flagship), the two work products, then side projects as briefs.
  Its results moved up into the band under the hero, so the lead is the
  story and the way into the case: the one tinted surface on the page, a
  larger title, and the strongest secondary button. data-project-card marks each card for
  analytics (projectSlugFromCard in src/scripts/analytics.ts): a click
  anywhere in it is attributed to the project through its case link.
*/}
<section id="projects" class="ed-section hp" aria-labelledby="projects-title">
  <div class="ed-row ed-mark">
    <p class="ed-label">{copy.title[locale]}</p>
    <div class="hp-lead">
      <h2 id="projects-title" class="ed-h2">{copy.heading[locale]}</h2>

      {featured && (
        <article class="hp-featured" data-project-card>
          <div class="hp-featured-head">
            <p class="hp-meta">
              <span>{copy.featuredEyebrow[locale]}</span>
              <span class="hp-live"><span class="hp-live-dot" aria-hidden="true"></span>{copy.featuredLiveBadge[locale]}</span>
            </p>
            <h3 class="hp-featured-title">
              {caseHrefFor(featured.id) ? <a href={caseHrefFor(featured.id)}>{featured.title[locale]}</a> : featured.title[locale]}
            </h3>
            <p class="hp-featured-role">{copy.featuredRole[locale]}</p>
          </div>
          <div class="hp-featured-body">
            <p class="hp-featured-summary">{featured.summary[locale]}</p>
            {caseHrefFor(featured.id) && (
              <a class="cta-button hp-featured-cta" href={caseHrefFor(featured.id)}>
                {copy.caseLink[locale]}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} />
              </a>
            )}
          </div>
        </article>
      )}
    </div>
  </div>

  <div class="ed-row hp-group">
    <h3 class="ed-label">{copy.workTitle[locale]}</h3>
    <div class="hp-cards">
      {workLed.map((project) => {
        const href = caseHrefFor(project.id);
        return (
          <article class="hp-card" data-project-card>
            <div class="hp-card-head">
              <h4>{href ? <a href={href}>{project.title[locale]}</a> : project.title[locale]}</h4>
              {statusFor(project.id) && <span class="hp-chip">{statusFor(project.id)}</span>}
            </div>
            <p class="hp-card-summary">{project.summary[locale]}</p>
            <p class="hp-card-links">
              {href && (
                <a href={href}>
                  {copy.caseShort[locale]}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={arrow} />
                </a>
              )}
              {project.demoUrl && project.id === 'cursivo' && (
                <a href={project.demoUrl} target="_blank" rel="noreferrer">
                  cursivo.xyz
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={external} />
                </a>
              )}
            </p>
          </article>
        );
      })}
    </div>
  </div>

  <div class="ed-row hp-group">
    <h3 class="ed-label">{copy.petTitle[locale]}</h3>
    <ul class="hp-pets">
      {pets.map((project) => {
        const href = caseHrefFor(project.id);
        return (
          <li>
            <article class="hp-pet" data-project-card>
              <h4 class="hp-pet-name">{href ? <a href={href}>{project.title[locale]}</a> : project.title[locale]}</h4>
              <p class="hp-pet-type">{project.appType[locale]}</p>
              {project.shipTime && <p class="hp-pet-time">{project.shipTime[locale]}</p>}
              {project.repoUrl ? (
                <a class="hp-pet-repo" href={project.repoUrl} target="_blank" rel="noreferrer">
                  GitHub
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={external} />
                </a>
              ) : <span class="hp-pet-repo" aria-hidden="true"></span>}
            </article>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  /* --- Lead story ------------------------------------------------------ */

  .hp-lead {
    display: grid;
    gap: clamp(1.5rem, 2.6vw, 2.25rem);
    padding-bottom: clamp(2.25rem, 4vw, 3.25rem);
  }

  /* The lead story outranks the rows under it: name and role on the left,
     what it is and the way in on the right, on a faint accent surface. */
  .hp-featured {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    align-items: start;
    gap: 1.25rem clamp(1.75rem, 4vw, 3.5rem);
    padding: clamp(1.4rem, 2.8vw, 2.4rem);
    border: 1px solid color-mix(in oklab, var(--accent) 22%, var(--border));
    border-radius: 1.1rem;
    background: color-mix(in oklab, var(--accent) 5%, var(--surface));
    transition: border-color var(--dur-fast) var(--ease-out-strong);
  }

  @media (hover: hover) and (pointer: fine) {
    .hp-featured:hover {
      border-color: color-mix(in oklab, var(--accent) 42%, var(--border));
    }
  }

  .hp-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--foreground) 70%, transparent);
  }

  .hp-live {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent-text);
  }

  .hp-live-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }

  .hp-featured-title {
    margin: 0.75rem 0 0;
    font-size: clamp(1.75rem, 1.8vw + 1.05rem, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.05;
  }

  .hp-featured-title a,
  .hp-card h4 a,
  .hp-pet-name a {
    color: inherit;
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .hp-featured-title a:hover,
    .hp-card h4 a:hover,
    .hp-pet-name a:hover {
      color: var(--accent-text);
    }
  }

  .hp-featured-role {
    margin: 0.8rem 0 0;
    max-width: 30rem;
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--text-muted);
    text-wrap: balance;
  }

  .hp-featured-body {
    display: grid;
    justify-items: start;
    gap: 1.35rem;
    padding-top: 0.15rem;
  }

  .hp-featured-summary {
    margin: 0;
    max-width: 36rem;
    font-size: clamp(1.04rem, 0.3vw + 0.96rem, 1.15rem);
    line-height: 1.55;
    color: color-mix(in oklab, var(--foreground) 84%, transparent);
    text-wrap: pretty;
  }

  /* The strongest secondary action on the page: accent-outlined, so it
     reads as the way into the case without competing with the dark
     Telegram button. */
  .hp-featured-cta {
    min-height: 3rem;
    height: auto;
    padding: 0.85rem 1.25rem;
    border-color: color-mix(in oklab, var(--accent-text) 55%, transparent);
    background: color-mix(in oklab, var(--accent) 9%, transparent);
    color: var(--accent-text);
    font-weight: 600;
    line-height: 1.2;
  }

  .hp-featured-cta svg {
    transition: transform var(--dur-fast) var(--ease-out-strong);
  }

  @media (hover: hover) and (pointer: fine) {
    .hp-featured-cta:hover {
      border-color: var(--accent-text);
      background: color-mix(in oklab, var(--accent) 16%, transparent);
    }

    .hp-featured-cta:hover svg {
      transform: translateX(3px);
    }
  }

  .hp-featured-cta:active {
    transform: scale(0.98);
  }

  /* --- Groups ---------------------------------------------------------- */

  .hp-group {
    padding-bottom: clamp(2rem, 3.6vw, 2.75rem);
  }

  .hp-group:last-child {
    padding-bottom: 0;
  }

  .hp-cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .hp-card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    align-content: start;
    gap: 0.5rem;
    padding-inline: 0 clamp(1.25rem, 2.6vw, 2.25rem);
  }

  .hp-card + .hp-card {
    padding-inline: clamp(1.25rem, 2.6vw, 2.25rem) 0;
    border-left: 1px solid var(--border);
  }

  .hp-card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 0.9rem;
  }

  .hp-card h4 {
    margin: 0;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  /* A quiet status note beside the name, not a pill. */
  .hp-chip {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .hp-card-summary {
    margin: 0;
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.55;
    color: color-mix(in oklab, var(--foreground) 78%, transparent);
  }

  .hp-card-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.25rem;
    margin: 0.3rem 0 0;
    font-size: 0.9rem;
    font-weight: 500;
  }

  .hp-card-links a,
  .hp-pet-repo {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--accent-text);
    text-decoration: none;
  }

  .hp-card-links svg,
  .hp-pet-repo svg {
    width: 0.9rem;
    height: 0.9rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .hp-card-links a:hover,
    a.hp-pet-repo:hover {
      text-decoration: underline;
      text-underline-offset: 0.25em;
    }
  }

  /* --- Side projects: briefs, one line each ---------------------------- */

  .hp-pets {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hp-pet {
    display: grid;
    grid-template-columns: minmax(7rem, 0.9fr) minmax(0, 2.4fr) 5rem 5rem;
    align-items: baseline;
    gap: 0.4rem 1.5rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--border);
  }

  .hp-pets li:first-child .hp-pet {
    padding-top: 0;
  }

  .hp-pets li:last-child .hp-pet {
    padding-bottom: 0;
    border-bottom: 0;
  }

  .hp-pet-name {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .hp-pet-type {
    margin: 0;
    font-size: 0.93rem;
    color: color-mix(in oklab, var(--foreground) 75%, transparent);
  }

  .hp-pet-time {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .hp-pet-repo {
    justify-self: end;
    font-size: 0.85rem;
    font-weight: 500;
  }

  @media (max-width: 960px) {
    .hp-featured {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 720px) {
    .hp-featured {
      padding: 1.25rem 1.15rem 1.35rem;
      border-radius: 0.95rem;
    }

    .hp-featured-cta {
      width: 100%;
    }

    .hp-cards {
      grid-template-columns: minmax(0, 1fr);
    }

    .hp-card,
    .hp-card + .hp-card {
      padding-inline: 0;
      border-left: 0;
    }

    .hp-card + .hp-card {
      margin-top: 1.25rem;
      padding-top: 1.25rem;
      border-top: 1px solid var(--border);
    }

    .hp-pet {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.25rem 1rem;
    }

    .hp-pet-type {
      grid-column: 1 / -1;
      grid-row: 2;
    }

    .hp-pet-time {
      grid-column: 2;
      grid-row: 1;
      justify-self: end;
    }

    .hp-pet-repo {
      grid-column: 1 / -1;
      grid-row: 3;
      justify-self: start;
    }

    .hp-pet-repo:empty {
      display: none;
    }
  }

  /* The global reduce block (global.css) stops .cta-button presses, but these
     scoped rules outrank it: no arrow slide, no press scale. The card's
     border-colour change stays, colour transitions are allowed. */
  @media (prefers-reduced-motion: reduce) {
    .hp-featured-cta svg {
      transition: none;
    }

    .hp-featured-cta:active,
    .hp-featured-cta:hover svg {
      transform: none;
    }
  }
</style>
