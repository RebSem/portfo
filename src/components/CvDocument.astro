---
import type { Locale } from '../types/content';
import {
  cvAntiFit,
  cvAntiFitIntro,
  cvEducation,
  cvExperience,
  cvHeadline,
  cvLanguages,
  cvLanguagesFile,
  cvLocationLine,
  cvMetrics,
  cvName,
  cvProducts,
  cvRoles,
  cvSkillGroups,
  cvSummary,
  cvWorkFormat,
  caseHref,
  email,
  githubUrl,
  githubUsername,
  linkedinHandle,
  linkedinUrl,
  phone,
  runHref,
  siteHost,
  siteUrl,
  telegramHandle,
  telegramUrl,
} from '../data/cv';
import { CV_SECTION_TITLES } from '../lib/cv-text';

interface Props {
  locale: Locale;
  pdfHref: string;
  docxHref: string;
  txtHref: string;
}

const { locale, pdfHref, docxHref, txtHref } = Astro.props;
const isRu = locale === 'ru';

// Build date, not a hand-maintained string: a stale "updated" line on a resume
// is worse than none. Fixed locale and timezone so the output does not depend
// on the machine that runs the build.
//
// Perm rather than UTC: a build run late in the evening local time is still
// UTC "yesterday", and the page was dating itself a day behind. The date a
// reader compares against is the author's own.
const updatedAt = new Date();
const updatedLabel = new Intl.DateTimeFormat(isRu ? 'ru-RU' : 'en-GB', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
  timeZone: 'Asia/Yekaterinburg',
}).format(updatedAt);

const copy = {
  // Section names come from cv-text.ts so the page, the txt export and the
  // DOCX cannot end up calling the same section different things.
  sections: CV_SECTION_TITLES,
  toc: { ru: 'Разделы резюме', en: 'Resume sections' },
  downloadPdf: { ru: 'Скачать PDF', en: 'Download PDF' },
  writeTelegram: { ru: 'Написать в Telegram', en: 'Message on Telegram' },
  openLinkedin: { ru: 'LinkedIn', en: 'LinkedIn' },
  caseLink: { ru: 'Кейс', en: 'Case study' },
  liveLink: { ru: 'Сайт', en: 'Live' },
  roles: { ru: 'Роли', en: 'Roles' },
  education: { ru: 'Образование', en: 'Education' },
  languages: { ru: 'Языки', en: 'Languages' },
  format: { ru: 'Формат работы', en: 'Work format' },
  updated: { ru: 'Обновлено', en: 'Updated' },
  copy: { ru: 'Скопировать', en: 'Copy' },
  copied: { ru: 'Скопировано', en: 'Copied' },
  alsoAvailable: { ru: 'Ещё форматы:', en: 'Also as:' },
} as const;

/**
 * Wraps every hyphenated token in a nowrap span.
 *
 * When a compound word wraps at its hyphen, the PDF text layer loses the
 * hyphen entirely: "full-time" came out of pdftotext as "Fulltime", and the
 * Russian PDF turned "LLM-аналитика" into "LLMаналитика" and
 * "юнит-экономика" into "юнитэкономика". Those are keywords an ATS and a
 * recruiter search on, and all three were silently destroyed.
 *
 * There is no CSS property that suppresses a break after a hyphen. Measured
 * across a width sweep in headless Chrome: `white-space: pre-wrap` and
 * `word-break: keep-all` both still break; only an inline nowrap span holds.
 *
 * The character stream is untouched, so HTML text extraction, copy-paste and
 * the txt/DOCX exports all still see a plain ASCII hyphen.
 */
const escapeHtml = (value: string) =>
  value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');

const HYPHENATED = /[\p{L}\p{N}]-[\p{L}\p{N}]/u;

const nb = (value: string): string =>
  escapeHtml(value)
    .split(/(\s+)/)
    .map((chunk) => (HYPHENATED.test(chunk) ? `<span class="nb">${chunk}</span>` : chunk))
    .join('');

const sectionIds = [
  { id: 'cv-summary', label: copy.sections.summary },
  { id: 'cv-metrics', label: copy.sections.metrics },
  { id: 'cv-experience', label: copy.sections.experience },
  { id: 'cv-products', label: copy.sections.products },
  { id: 'cv-skills', label: copy.sections.skills },
  { id: 'cv-background', label: copy.sections.background },
  { id: 'cv-anti-fit', label: copy.sections.antiFit },
  { id: 'cv-contact', label: copy.sections.contact },
];
---

<div class="cv-layout">
  <article class="cv-doc">
    {/* 1. Visitka */}
    <header class="cv-head">
      <p class="cv-eyebrow">CV</p>
      <h1 class="cv-name">{cvName[locale]}</h1>
      <p class="cv-headline" set:html={nb(cvHeadline[locale])} />
      {/* `phone` is undefined in every public build. It only resolves in the
          local, git-ignored build that produces the ATS-form exports.
          nowrap is load-bearing: when the number wrapped at its hyphen, the
          PDF text layer came out as "+7 982 230-6019", one digit group short
          of a number anyone could dial. */}
      <p class="cv-location">
        <span set:html={nb(cvLocationLine[locale])} />
        {phone && <> · <span class="cv-phone">{phone}</span></>}
      </p>

      {/*
        Contacts belong at the top of a resume, and until now they were only
        at the bottom, where print.css hid them: the generated PDF carried no
        email, no Telegram and no LinkedIn at all. A recruiter who saved it
        had no way to reply, and an ATS that keys candidate identity on an
        email address would have dropped the record.
      */}
      <ul class="cv-contacts">
        <li><a href={`mailto:${email}`}>{email}</a></li>
        <li><a href={telegramUrl} rel="me noopener">{telegramHandle}</a></li>
        <li><a href={linkedinUrl} rel="me noopener">{linkedinHandle}</a></li>
        <li><a href={githubUrl} rel="me noopener">github.com/{githubUsername}</a></li>
        <li><a href={`${siteUrl}/`}>{siteHost}</a></li>
      </ul>

      <div class="cv-actions">
        <a class="cta-button cta-primary" href={pdfHref} download>{copy.downloadPdf[locale]}</a>
        <a class="cta-button cta-secondary" href={telegramUrl} rel="me noopener">{copy.writeTelegram[locale]}</a>
        <a class="cta-button cta-secondary" href={linkedinUrl} rel="me noopener">{copy.openLinkedin[locale]}</a>
      </div>

      {/*
        The DOCX is the artifact that survives an ATS import best: real
        heading styles, real list numbering, hyphens intact. It existed but
        nothing linked to it, so the only file anyone could reach was the PDF.
        Secondary styling on purpose, since most readers want the PDF.
      */}
      <p class="cv-formats">
        {copy.alsoAvailable[locale]}
        <a href={docxHref} download>DOCX</a>
        <a href={txtHref} target="_blank" rel="noopener">TXT</a>
      </p>
    </header>

    {/* Summary */}
    <section class="cv-section" id="cv-summary" aria-labelledby="cv-summary-title">
      <h2 class="cv-section-title" id="cv-summary-title">{copy.sections.summary[locale]}</h2>
      <p class="cv-lead" set:html={nb(cvSummary[locale])} />
    </section>

    {/* 2. Metrics */}
    <section class="cv-section" id="cv-metrics" aria-labelledby="cv-metrics-title">
      <h2 class="cv-section-title" id="cv-metrics-title">{copy.sections.metrics[locale]}</h2>
      <ul class="cv-metrics">
        {cvMetrics.map((metric) => (
          <li class="cv-metric">
            <p class="cv-metric-value">{metric.value[locale]}</p>
            <p class="cv-metric-label" set:html={nb(metric.label[locale])} />
            <p class="cv-metric-caption" set:html={nb(metric.caption[locale])} />
          </li>
        ))}
      </ul>
    </section>

    {/* 3. Experience */}
    <section class="cv-section" id="cv-experience" aria-labelledby="cv-experience-title">
      <h2 class="cv-section-title" id="cv-experience-title">{copy.sections.experience[locale]}</h2>

      {cvExperience.map((role) => (
        <div class="cv-role">
          <div class="cv-role-head">
            <h3 class="cv-role-title">
              {role.role[locale]}, {role.company[locale]}
            </h3>
            <p class="cv-role-period">{role.period[locale]}</p>
          </div>

          {role.context && <p class="cv-role-context" set:html={nb(role.context[locale])} />}

          {role.phases.map((phase) => (
            <div class="cv-phase">
              {phase.title[locale] && <p class="cv-phase-title" set:html={nb(phase.title[locale])} />}
              <ul class="cv-bullets">
                {phase.bullets.map((runs) => (
                  <li>
                    {runs.map((run) => {
                      const href = runHref(run, locale);
                      return href
                        ? <a href={href} set:html={nb(run.text[locale])} />
                        : <span set:html={nb(run.text[locale])} />;
                    })}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      ))}
    </section>

    {/* 4. Products */}
    <section class="cv-section" id="cv-products" aria-labelledby="cv-products-title">
      <h2 class="cv-section-title" id="cv-products-title">{copy.sections.products[locale]}</h2>
      <ul class="cv-products">
        {cvProducts.map((product) => (
          <li class="cv-product">
            <h3 class="cv-product-name">{product.name}</h3>
            <p class="cv-product-summary" set:html={nb(product.summary[locale])} />
            <p class="cv-product-proof" set:html={nb(product.proof[locale])} />
            <p class="cv-product-links">
              {product.caseId && (
                <a
                  href={caseHref(product.caseId, locale)}
                  aria-label={`${copy.caseLink[locale]}: ${product.name}`}
                >{copy.caseLink[locale]}</a>
              )}
              {product.externalUrl && (
                <a
                  href={product.externalUrl}
                  rel="noopener"
                  aria-label={`${product.externalUrl === githubUrl ? 'GitHub' : copy.liveLink[locale]}: ${product.name}`}
                >{product.externalUrl === githubUrl ? 'GitHub' : copy.liveLink[locale]}</a>
              )}
            </p>
          </li>
        ))}
      </ul>
    </section>

    {/* 5. Skills */}
    <section class="cv-section" id="cv-skills" aria-labelledby="cv-skills-title">
      <h2 class="cv-section-title" id="cv-skills-title">{copy.sections.skills[locale]}</h2>
      <dl class="cv-skills">
        <div class="cv-skill-group">
          <dt>{copy.roles[locale]}</dt>
          <dd set:html={nb(cvRoles[locale])} />
        </div>
        {cvSkillGroups.map((group) => (
          <div class="cv-skill-group">
            <dt>{group.label[locale]}</dt>
            <dd set:html={nb(group.items.map((item) => item[locale]).join(', '))} />
          </div>
        ))}
      </dl>
    </section>

    {/* 6. Education, languages, format */}
    <section class="cv-section" id="cv-background" aria-labelledby="cv-background-title">
      <h2 class="cv-section-title" id="cv-background-title">{copy.sections.background[locale]}</h2>
      <dl class="cv-skills">
        <div class="cv-skill-group">
          <dt>{copy.education[locale]}</dt>
          <dd set:html={nb(cvEducation[locale])} />
        </div>
        <div class="cv-skill-group">
          <dt>{copy.languages[locale]}</dt>
          {/* The PDF is printed from this page, so it carries the file variant
              of the same fact: no CEFR code, which a form robot reads as a
              filter before a human reads the rest. See cvLanguagesFile. */}
          <dd>
            <span class="cv-screen-only" set:html={nb(cvLanguages[locale])} />
            <span class="cv-print-only" set:html={nb(cvLanguagesFile[locale])} />
          </dd>
        </div>
        <div class="cv-skill-group">
          <dt>{copy.format[locale]}</dt>
          <dd set:html={nb(cvWorkFormat[locale])} />
        </div>
      </dl>
    </section>

    {/* 7. Anti-fit */}
    <section class="cv-section" id="cv-anti-fit" aria-labelledby="cv-anti-fit-title">
      <h2 class="cv-section-title" id="cv-anti-fit-title">{copy.sections.antiFit[locale]}</h2>
      <p class="cv-lead" set:html={nb(cvAntiFitIntro[locale])} />
      <ul class="cv-bullets">
        {cvAntiFit.map((item) => <li set:html={nb(item[locale])} />)}
      </ul>
    </section>

    {/* 8. Contact footer */}
    <section class="cv-section cv-contact" id="cv-contact" aria-labelledby="cv-contact-title">
      <h2 class="cv-section-title" id="cv-contact-title">{copy.sections.contact[locale]}</h2>
      <ul class="cv-contact-list">
        {phone && <li><a href={`tel:${phone.replace(/[^+\d]/g, '')}`}>{phone}</a></li>}
        <li>
          <a href={`mailto:${email}`}>{email}</a>
          <button
            type="button"
            class="cv-copy"
            data-cv-copy={email}
            aria-label={`${copy.copy[locale]}: ${email}`}
            hidden
          >
            <span class="cv-copy-idle">{copy.copy[locale]}</span>
            {/* Announced, not just shown: the idle -> copied swap was purely
                visual, so a screen-reader user got no confirmation at all. */}
            <span class="cv-copy-done" role="status">{copy.copied[locale]}</span>
          </button>
        </li>
        <li>
          <a href={telegramUrl} rel="me noopener">{telegramHandle}</a>
          <button
            type="button"
            class="cv-copy"
            data-cv-copy={telegramHandle}
            aria-label={`${copy.copy[locale]}: ${telegramHandle}`}
            hidden
          >
            <span class="cv-copy-idle">{copy.copy[locale]}</span>
            <span class="cv-copy-done" role="status">{copy.copied[locale]}</span>
          </button>
        </li>
        <li><a href={linkedinUrl} rel="me noopener">{linkedinHandle}</a></li>
        <li><a href={githubUrl} rel="me noopener">github.com/RebSem</a></li>
        <li><a href={`https://${siteHost}/`}>{siteHost}</a></li>
      </ul>
      <p class="cv-updated">{copy.updated[locale]}: {updatedLabel}</p>
    </section>
  </article>

  {/* Desktop-only table of contents. Placed after the resume in the markup
      even though it renders to its right: with `order: 2` doing the moving,
      DOM order disagreed with visual order and a keyboard user tabbed through
      eight navigation links before reaching the candidate's name (WCAG 1.3.2,
      2.4.3). Grid puts it in the second column by source order instead.
      Purely navigational, so nothing is lost when it is hidden on narrow
      screens or without JS. */}
  <nav class="cv-toc" aria-label={copy.toc[locale]}>
    <ol>
      {sectionIds.map((section) => (
        <li>
          <a href={`#${section.id}`} data-cv-toc-link={section.id}>{section.label[locale]}</a>
        </li>
      ))}
    </ol>
  </nav>
</div>

<style>
  .cv-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    align-items: start;
  }

  /* Navigation only, so it simply does not exist on narrow screens rather
     than collapsing into something that competes with the resume itself.
     Declared before the media query so the wide-screen override wins. */
  .cv-toc {
    display: none;
  }

  @media (min-width: 1080px) {
    /* The document column is capped at its reading measure, and the table
       of contents sits right after it rather than at the far edge of the
       container: with a 1fr column the two drifted 20rem apart. */
    .cv-layout {
      grid-template-columns: minmax(0, 42.5rem) 13rem;
      justify-content: start;
      gap: 4rem;
    }

    .cv-toc {
      position: sticky;
      top: 5.5rem;
      display: block;
    }
  }

  .cv-toc ol {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    border-left: 1px solid var(--border);
  }

  .cv-toc a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.85rem;
    margin-left: -1px;
    border-left: 2px solid transparent;
    color: color-mix(in oklab, var(--foreground) 68%, transparent);
    font-size: 0.82rem;
    line-height: 1.35;
    text-decoration: none;
    transition:
      color var(--dur-fast) var(--ease-out-strong),
      border-color var(--dur-fast) var(--ease-out-strong);
  }

  .cv-toc a:hover,
  .cv-toc a:focus-visible {
    color: var(--foreground);
  }

  .cv-toc a[aria-current='true'] {
    color: var(--accent-text);
    border-left-color: var(--accent);
  }

  /* 680px: a document measure rather than a landing-page one. The wider
     column read as marketing; this reads as a resume. */
  .cv-doc {
    min-width: 0;
    max-width: 42.5rem;
  }

  .cv-print-only {
    display: none;
  }

  .cv-eyebrow {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--foreground) 68%, transparent);
  }

  .cv-name {
    margin: 0;
    font-size: clamp(2.1rem, 6vw, 3rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .cv-headline {
    margin: 0.7rem 0 0;
    font-size: clamp(1rem, 2.4vw, 1.15rem);
    font-weight: 500;
    color: var(--foreground);
  }

  /* Emitted by nb() around every hyphenated token. See the comment on that
     helper: this is what keeps "full-time" and "юнит-экономика" intact in the
     PDF text layer.
     :global is required, not stylistic. Astro scopes styles by stamping a
     data-astro-cid attribute onto the markup it renders, and it does not
     stamp markup injected through set:html. Scoped, this compiled to
     `.nb[data-astro-cid-…]` and matched nothing, so the spans shipped with no
     nowrap at all and the hyphens kept breaking. */
  :global(.nb) {
    white-space: nowrap;
  }

  .cv-phone {
    white-space: nowrap;
  }

  .cv-contacts {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.9rem;
    margin: 0.55rem 0 0;
    padding: 0;
    font-size: 0.9rem;
  }

  /* Separators come from CSS rather than markup so the text layer of the PDF
     reads as a clean list of addresses with nothing between them. */
  .cv-contacts li + li::before {
    content: '·';
    margin-right: 0.9rem;
    color: color-mix(in oklab, var(--foreground) 40%, transparent);
  }

  .cv-location {
    margin: 0.45rem 0 0;
    color: color-mix(in oklab, var(--foreground) 72%, transparent);
    font-size: 0.92rem;
  }

  .cv-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.35rem;
  }

  .cv-formats {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.65rem;
    margin: 0.9rem 0 0;
    font-size: 0.82rem;
    color: color-mix(in oklab, var(--foreground) 68%, transparent);
  }

  .cv-section {
    margin-top: 2.6rem;
    /* Clears the sticky header when a table-of-contents anchor jumps here. */
    scroll-margin-top: 5.5rem;
  }

  /*
   * Same entrance the rest of the site uses on .page-main > section, which the
   * resume was missing because its sections sit inside .cv-doc rather than
   * directly under .page-main. @starting-style rather than a keyframe on
   * purpose: the resting state is the visible one, so if the browser does not
   * support it, or a parser never renders at all, the text is simply there.
   * Short and shallow, 280ms over 6px: a recruiter came to read, not to watch.
   */
  .cv-head,
  .cv-doc > section {
    transition:
      opacity 280ms var(--ease-out-strong),
      transform 280ms var(--ease-out-strong);

    @starting-style {
      opacity: 0;
      transform: translateY(6px);
    }
  }

  .cv-doc > section:nth-of-type(2) { transition-delay: 45ms; }
  .cv-doc > section:nth-of-type(3) { transition-delay: 90ms; }
  .cv-doc > section:nth-of-type(4) { transition-delay: 135ms; }

  .cv-section-title {
    margin: 0 0 0.9rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--foreground) 68%, transparent);
  }

  .cv-lead {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
  }

  /* Metrics: one column on a phone, which is where half the recruiters open
     a Telegram link. Grid rather than flex so the four tiles stay equal. */
  .cv-metrics {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .cv-metrics {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .cv-metric {
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 0.85rem;
    background: var(--surface);
  }

  /* In the dark theme --surface sits a hair above --background and the tiles
     dissolved into the page; a slightly stronger hairline keeps them legible
     as tiles without adding a glow. */
  :global([data-theme='dark']) .cv-metric {
    border-color: color-mix(in oklab, var(--foreground) 14%, var(--border));
  }

  .cv-metric-value {
    margin: 0;
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--accent-text);
  }

  .cv-metric-label {
    margin: 0.25rem 0 0;
    font-size: 0.92rem;
    font-weight: 500;
  }

  .cv-metric-caption {
    margin: 0.4rem 0 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: color-mix(in oklab, var(--foreground) 72%, transparent);
  }

  .cv-role + .cv-role {
    margin-top: 1.9rem;
  }

  .cv-role-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.3rem 1rem;
  }

  .cv-role-title {
    margin: 0;
    font-size: 1.08rem;
    font-weight: 600;
  }

  .cv-role-period {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: color-mix(in oklab, var(--foreground) 65%, transparent);
    white-space: nowrap;
  }

  .cv-role-context {
    margin: 0.5rem 0 0;
    font-size: 0.92rem;
    color: color-mix(in oklab, var(--foreground) 72%, transparent);
    line-height: 1.55;
  }

  .cv-phase {
    margin-top: 1.05rem;
  }

  .cv-phase-title {
    margin: 0 0 0.5rem;
    font-size: 0.92rem;
    font-weight: 600;
  }

  .cv-bullets {
    margin: 0;
    padding-left: 1.15rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .cv-bullets li {
    font-size: 0.95rem;
    line-height: 1.68;
  }

  .cv-products {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }

  @media (min-width: 640px) {
    .cv-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

