---
import { avBooking, avHero, avVacancy, meme } from '../../data/aviasales';
import { cvName, email, telegramHandle, telegramUrl } from '../../data/cv';

// The vacancy PDF, printed from this page by `npm run cv:export` (scripts/cv/build-exports.ts).
const pdfHref = '/cv/aviasales/Mikhail_Semenov_PM_Hotels.pdf';
const paris = meme('paris');

// The pass prints the name surname first, as on a real boarding pass.
const [first = '', last = ''] = cvName.ru.split(' ');
const passName = `${last} / ${first}`.toUpperCase();
const passRoute = avHero.board[0];
---

<section class="av-booking av-container av-section" aria-labelledby="av-booking-title" data-analytics-placement="aviasales-booking">
  <h2 id="av-booking-title" class="av-h2">
    <span data-av-meme>{avBooking.title}</span><span data-av-plain hidden>{avBooking.titlePlain}</span>
  </h2>

  <div class="av-booking__grid">
    <dl class="av-booking__summary" data-av-meme>
      {avBooking.rows.map((r) => (<div><dt>{r.k}</dt><dd>{r.v}</dd></div>))}
    </dl>

    <div class="av-booking__act">
      <a class="av-btn av-btn--primary av-btn--xl" href={telegramUrl} target="_blank" rel="noopener" data-av-book>
        {avBooking.cta}
      </a>
      <p class="av-booking__handle">Telegram: {telegramHandle}</p>
      <p class="av-booking__place">{avBooking.place}</p>
      {paris && <p class="av-booking__hours" data-av-meme>{paris}</p>}
      <p class="av-booking__alt">
        <a href={pdfHref} download rel="nofollow" data-astro-prefetch="false">Скачать PDF</a>
        <span aria-hidden="true">·</span>
        <a href="/ru/cv/" rel="nofollow">Обычное резюме</a>
        <span aria-hidden="true">·</span>
        <a href={`mailto:${email}`}>{email}</a>
      </p>
    </div>
  </div>

  {/* A11: shown only after the booking button is pressed, and it stays; a second press prints it again. */}
  <div class="av-pass" data-av-pass data-av-meme aria-live="polite">
    <div class="av-pass__main">
      <p class="av-pass__label">Посадочный талон</p>
      <p class="av-pass__name">{passName}</p>
      <dl class="av-pass__grid">
        <div><dt>Рейс</dt><dd>{avVacancy.flight}</dd></div>
        <div><dt>Маршрут</dt><dd>{passRoute}</dd></div>
        <div><dt>Место</dt><dd>1A</dd></div>
        <div><dt>Выход</dt><dd>TELEGRAM</dd></div>
      </dl>
    </div>
    <div class="av-pass__stub">
      <div class="av-pass__code" aria-hidden="true"><span class="av-pass__scan"></span></div>
      <p>{avBooking.passNote}</p>
    </div>
  </div>
</section>
