---
import AvNb from './AvNb.astro';
import AvPlane from './AvPlane.astro';
import { avHero } from '../../data/aviasales';
import { email, telegramHandle } from '../../data/cv';
---

<section class="av-hero" aria-labelledby="av-hero-title" data-av-progress>
  <div class="av-container av-hero__inner">
    <div class="av-hero__top">
      <nav class="av-tabs" aria-label="Разделы">
        {avHero.tabs.map((tab) => (
          <a
            class="av-tab"
            href={tab.href}
            rel={tab.nofollow ? 'nofollow' : undefined}
            aria-current={tab.current ? 'page' : undefined}
          >{tab.label}</a>
        ))}
      </nav>
      <button type="button" class="av-calm" data-av-calm-toggle aria-pressed="false" title={avHero.calm.title} hidden>
        {/* The plane climbs to the upper right, as on a phone's flight-mode switch. */}
        <svg class="av-calm__icon" viewBox="-12 -12 24 24" aria-hidden="true" focusable="false">
          <g class="av-calm__plane"><AvPlane bare /></g>
          <path class="av-calm__gap" d="M-9 -9 9 9" pathLength="1"></path>
          <path class="av-calm__strike" d="M-9 -9 9 9" pathLength="1"></path>
        </svg>
        <span data-av-calm-label>{avHero.calm.off}</span>
      </button>
    </div>

    <h1 id="av-hero-title" class="av-hero__title">
      <span data-av-meme>{avHero.h1}</span>
      <span data-av-plain hidden>{avHero.h1Plain}</span>
    </h1>
    <p class="av-hero__lead"><AvNb text={avHero.lead} /></p>

    <div class="av-hero__sky" aria-hidden="true" data-av-meme>
      {/* A1: the flight, inside the grid so it never covers the text. A5 clouds are a later pass.
           The markup is the last frame: the route drawn, the plane landed beside the bed pin.
           The script flies the plane and its shadow along the route and then puts these
           transforms back. */}
      <svg class="av-flight" viewBox="0 0 600 220" aria-hidden="true" focusable="false">
        <defs>
          <mask id="av-route-mask" maskUnits="userSpaceOnUse" x="0" y="0" width="600" height="220">
            <path class="av-flight__reveal" d="M30 188C128 49 363 45 490 124" pathLength="1"></path>
          </mask>
        </defs>
        <circle class="av-flight__from" cx="30" cy="188" r="7"></circle>
        <path class="av-flight__route" d="M30 188C128 49 363 45 490 124" mask="url(#av-route-mask)"></path>
        <circle class="av-flight__ring" cx="548" cy="160" r="34"></circle>
        <g class="av-flight__bed">
          <circle cx="548" cy="160" r="34"></circle>
          <path d="M530 172v-21m0 9h13a6 6 0 0 1 6 6h11a6 6 0 0 1 6 6m-36 0h36v6"></path>
        </g>
        <g class="av-flight__shadow" transform="translate(490 124) rotate(32) scale(2)"><AvPlane bare /></g>
        <g class="av-flight__plane" data-av-plane transform="translate(490 124) rotate(32) scale(2)"><AvPlane bare /></g>
      </svg>
    </div>

    {/* Paper only. The H1 and the lead already name him twice, so this line keeps just the place. */}
    <div class="av-print-only">
      <p>Пермь, GMT+5 · удалённо</p>
      <p>Telegram: {telegramHandle} · {email} · rebsem.ru</p>
      <p>Интерактивная версия этого резюме: rebsem.ru/ru/aviasales</p>
    </div>

    <div class="av-search" role="group" aria-label={avHero.searchAria}>
      <div class="av-search__fields">
        {avHero.search.map((f) => (
          <div class="av-search__field">
            <span class="av-search__label">{f.label}</span>
            <span class="av-search__value">{f.value}</span>
          </div>
        ))}
      </div>
      <a class="av-btn av-btn--primary av-search__go" href="#av-results" data-av-search-go>{avHero.searchButton}</a>
    </div>
    <p class="av-loader" data-av-loader data-av-meme data-lines={JSON.stringify(avHero.loader)} role="status"></p>
    {/* A7: flies the short route in front of each caption. A sibling, not a child: the script owns the loader's text. */}
    <AvPlane class="av-loader__plane" />

    <p class="av-board" data-av-board data-av-meme>{avHero.board.join(' · ')}</p>
  </div>
</section>
