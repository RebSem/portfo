---
// The one airplane of the landing: an airliner seen from above, drawn for this page.
// The nose points right at zero rotation and the 24-unit box is centred on the origin,
// so a rotate() needs no pivot and a tangent angle can be used as it is.
// `bare` gives the path alone, for use inside another <svg>.
interface Props {
  class?: string;
  bare?: boolean;
}

const { class: className, bare = false } = Astro.props;
const d =
  'M11.4 0C11.4-1.25 9.9-2.15 7.8-2.15H4L-.2-9.6C-.5-10.2-1.1-10.5-1.8-10.5H-3C-3.7-10.5-4.1-9.9-3.9-9.3L-1.8-1.95-6.1-1.55-7.9-4.6C-8.1-5-8.5-5.2-8.9-5.2H-9.8C-10.3-5.2-10.7-4.7-10.5-4.2L-9.5-1C-9.3-.6-9.2-.3-9.2 0-9.2.3-9.3.6-9.5 1L-10.5 4.2C-10.7 4.7-10.3 5.2-9.8 5.2H-8.9C-8.5 5.2-8.1 5-7.9 4.6L-6.1 1.55-1.8 1.95-3.9 9.3C-4.1 9.9-3.7 10.5-3 10.5H-1.8C-1.1 10.5-.5 10.2-.2 9.6L4 2.15H7.8C9.9 2.15 11.4 1.25 11.4 0ZM4.7-5.6A.9.9 0 0 0 3.8-6.5H1.4V-4.7H3.8A.9.9 0 0 0 4.7-5.6ZM4.7 5.6A.9.9 0 0 0 3.8 4.7H1.4V6.5H3.8A.9.9 0 0 0 4.7 5.6Z';
---

{bare ? (
  <path class={className} d={d}></path>
) : (
  <svg class={className} viewBox="-12 -12 24 24" aria-hidden="true" focusable="false"><path d={d} fill="currentColor"></path></svg>
)}
