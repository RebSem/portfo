---
interface Props {
  /** PNG paths under public/projects. The WebP variants are derived from them. */
  lightSrc: string;
  darkSrc: string;
  alt: string;
  caption?: string;
  /** Rendered width hint. Inside a ShotGrid a shot is about half the column,
      so the grid usages pass a smaller value and DPR-2 screens stop
      downloading the 2x file for a thumbnail. */
  sizes?: string;
}

const { lightSrc, darkSrc, alt, caption, sizes = '(max-width: 980px) 100vw, 880px' } = Astro.props;
const zoomLabel = `${alt}${Astro.currentLocale === 'ru' ? '. Открыть крупно' : '. Open full size'}`;

/**
 * The PNGs stay in the repo as the source; scripts/webp-shots.mjs writes a 2x
 * and a 1x WebP and AVIF beside each. Five 350 KB PNGs per theme on a case page
 * were the single heaviest thing on the site; the 1x AVIF is about 60 KB at most
 * and a laptop never asks for the 2x.
 */
const webp = (png: string) => png.replace(/\.png$/, '.webp');
const webp1x = (png: string) => png.replace(/\.png$/, '-1440.webp');
const srcset = (png: string) => `${webp1x(png)} 1440w, ${webp(png)} 2880w`;
// The AVIF source comes first in the <picture>; a browser without AVIF skips it
// and takes the WebP on the img.
const avif = (png: string) => png.replace(/\.png$/, '.avif');
const avif1x = (png: string) => png.replace(/\.png$/, '-1440.avif');
const avifSrcset = (png: string) => `${avif1x(png)} 1440w, ${avif(png)} 2880w`;
---

<figure class="project-shot">
  {/* A link to the full-size image, so a shot shrunk into a grid can still be
      read: with JS it opens in the lightbox below, without JS in a new tab.
      Prefetch is off: Astro would fetch the 2x of every shot on the page. */}
  <a class="project-shot-frame project-shot-zoom" href={webp(lightSrc)} target="_blank" rel="noopener" aria-label={zoomLabel} data-astro-prefetch="false">
    <div class="project-shot-bar" aria-hidden="true">
      <span class="project-shot-dot"></span>
      <span class="project-shot-dot"></span>
      <span class="project-shot-dot"></span>
    </div>
    {/* Theme swap lives in src/scripts/theme-images.js: it flips the img's src
        and srcset and the AVIF source's srcset from these data attributes. A
        matching <source> ignores the img's own src, so it must switch too. */}
    <picture>
      <source
        type="image/avif"
        srcset={avifSrcset(lightSrc)}
        sizes={sizes}
        data-light-srcset={avifSrcset(lightSrc)}
        data-dark-srcset={avifSrcset(darkSrc)}
      />
      <img
        src={webp1x(lightSrc)}
        srcset={srcset(lightSrc)}
        sizes={sizes}
        data-light-src={webp1x(lightSrc)}
        data-dark-src={webp1x(darkSrc)}
        data-light-srcset={srcset(lightSrc)}
        data-dark-srcset={srcset(darkSrc)}
        alt={alt}
        class="project-shot-img"
        loading="lazy"
        decoding="async"
        width="1440"
        height="900"
      />
    </picture>
  </a>
  {caption && <figcaption class="project-shot-caption">{caption}</figcaption>}
</figure>

<script>
  // One lightbox for every case screenshot. Bundled, so it runs once per
  // ClientRouter session; the click listener sits on `document`, which
  // survives swaps, and the dialog is created on demand because <body> does
  // not. Native <dialog>: Esc closes it and focus returns on its own.
  const LIGHTBOX = 'shot-lightbox';
  // The 2x the lightbox is waiting for. A 2x still loading for an earlier
  // shot must not replace the one open now.
  let awaitedFull = '';

  const lightbox = (): HTMLDialogElement => {
    let dialog = document.getElementById(LIGHTBOX) as HTMLDialogElement | null;
    if (dialog) return dialog;
    dialog = document.createElement('dialog');
    dialog.id = LIGHTBOX;
    dialog.className = LIGHTBOX;
    const close = document.createElement('button');
    close.type = 'button';
    close.className = `${LIGHTBOX}-close`;
    close.setAttribute('aria-label', document.documentElement.lang === 'ru' ? 'Закрыть' : 'Close');
    close.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>';
    close.addEventListener('click', () => dialog?.close());
    const image = document.createElement('img');
    image.className = `${LIGHTBOX}-img`;
    image.alt = '';
    dialog.append(close, image);
    // A click on the backdrop lands on the dialog itself, not on its content.
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog?.close();
    });
    document.body.append(dialog);
    return dialog;
  };

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    const link = target.closest<HTMLAnchorElement>('a.project-shot-zoom');
    if (!link || event.metaKey || event.ctrlKey || event.shiftKey || event.button !== 0) return;
    const thumb = link.querySelector('img');
    if (!thumb || typeof HTMLDialogElement !== 'function') return;
    event.preventDefault();
    const dialog = lightbox();
    const image = dialog.querySelector<HTMLImageElement>(`.${LIGHTBOX}-img`);
    if (!image) return;
    // The 1x the thumbnail already shows, in the theme that is showing
    // (theme-images.js keeps the picture on the active theme). The browser has
    // decoded it, so the frame is never empty while the 2x downloads.
    const shown = thumb.currentSrc || thumb.src;
    const full = shown.replace(/-1440\.(webp|avif)$/, '.$1');
    image.src = shown;
    image.alt = thumb.alt;
    dialog.setAttribute('aria-label', thumb.alt);
    dialog.showModal();
    awaitedFull = full;
    if (full === shown) return;
    // The 2x is decoded before it replaces the 1x, so the swap never flashes.
    const loader = new Image();
    loader.src = full;
    loader.decode().then(
      () => {
        if (awaitedFull === full && dialog.open) image.src = full;
      },
      () => undefined,
    );
  });
</script>
