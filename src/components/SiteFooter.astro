---
import SocialLinks from './SocialLinks.astro';
import { siteRepoUrl, telegramUrl, uiCopy } from '../data/site-content';
import { buildIntroMailto } from '../lib/intro-mail';

interface Props {
  noteRu?: string;
  noteEn?: string;
  /**
   * The home page and the case studies end here, so their footer is the
   * closing call to action: one question in the headline's type, the pitch
   * under it, Telegram and Email as buttons, a quiet Resume link after them,
   * and the status line again for the reader who scrolled to the end. The
   * case studies end on the next case first (CaseNext.astro). About ends on
   * its own call to action and keeps the pitch at reading size.
   */
  closing?: boolean;
  /**
   * The label rail is the editorial grid of the home page and the About rows.
   * Pages whose text starts at the container edge (the case studies) turn it
   * off, so the footer's column lines up with the page text above it.
   */
  rail?: boolean;
}

const {
  noteRu = uiCopy.footer.defaultNote.ru,
  noteEn = uiCopy.footer.defaultNote.en,
  closing = false,
  rail = true,
} = Astro.props;

const locale = Astro.currentLocale === 'ru' ? 'ru' : 'en';
const note = locale === 'ru' ? noteRu : noteEn;
const prefix = locale === 'ru' ? '/ru' : '';

// Word by word, so a line can only break between words: left to the
// browser, "Нужен продакт-менеджер?" splits at its hyphen.
const closingWords = uiCopy.footer.closingTitle[locale].split(' ');
---

<footer class:list={['site-footer', { 'site-footer-closing': closing, 'site-footer-norail': !rail }]} data-analytics-placement="footer">
  <div class="footer-inner">
    <div class="footer-main ed-row ed-mark">
      <p class="footer-eyebrow ed-label">{uiCopy.footer.eyebrow[locale]}</p>
      <div class="footer-body">
        {closing ? (
          <>
            <h2 class="footer-closing-title">
              {closingWords.map((word, index) => (
                <>{index > 0 && ' '}<span class="footer-word">{word}</span></>
              ))}
            </h2>
            <p class="footer-pitch">{uiCopy.footer.closingPitch[locale]}</p>
            <div class="footer-actions">
              <a class="cta-button cta-primary" href={telegramUrl} target="_blank" rel="noreferrer">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M4 11l16 -8l-4 18l-5 -4l-3 3l1 -5l8 -7" />
                </svg>
                {uiCopy.home.heroCtaPrimary[locale]}
              </a>
              <a class="cta-button cta-secondary" href={buildIntroMailto(locale)}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 7a2 2 0 0 1 2 -2h14a2 2 0 0 1 2 2v10a2 2 0 0 1 -2 2h-14a2 2 0 0 1 -2 -2v-10z" />
                  <path d="M3 7l9 6l9 -6" />
                </svg>
                {uiCopy.caseAvailability.email[locale]}
              </a>
              <a class="footer-cv" href={`${prefix}/cv/`} rel="nofollow">{uiCopy.footer.resume[locale]}</a>
              <SocialLinks hideTelegram hideEmail />
            </div>
            <p class="footer-status">
              <span class="footer-status-live">
                <span class="footer-status-dot" aria-hidden="true"></span>
                {uiCopy.home.heroStatus[locale]}
              </span>
              <span class="footer-status-format">{uiCopy.home.workFormat[locale]}</span>
            </p>
          </>
        ) : (
          <>
            <p class="footer-pitch">{uiCopy.footer.pitch[locale]}</p>
            <div class="footer-actions">
              <SocialLinks />
            </div>
            <p class="footer-note">{note}</p>
          </>
        )}
      </div>
    </div>

    <div class="footer-bottom">
      <nav class="footer-nav" aria-label={uiCopy.footer.navAria[locale]}>
        <a href={`${prefix}/`}>{uiCopy.nav.home[locale]}</a>
        <a href={`${prefix}/about/`}>{uiCopy.nav.about[locale]}</a>
        <a href="#top">{uiCopy.footer.backToTop[locale]}</a>
      </nav>

      <p class="footer-craft">
        {uiCopy.footer.craft[locale]}
        <a href={siteRepoUrl} target="_blank" rel="noreferrer">{uiCopy.footer.craftSource[locale]}</a>.
      </p>
    </div>
  </div>
</footer>
