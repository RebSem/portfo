---
import { execSync } from 'node:child_process';
import { getMergedPrCount } from '../lib/github';
import { agentOps, githubUsername } from '../data/site-content';
import type { Locale } from '../types/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = agentOps;

// Baked at build time; CI builds run from a real checkout, so this resolves
// to the deployed commit. Hidden entirely when git is unavailable.
let commitHash = '';
try {
  commitHash = execSync('git rev-parse --short HEAD', { encoding: 'utf8' }).trim();
} catch {
  // No git in the build environment — drop the deploy line.
}

const repoSlug = `${githubUsername}/portfo`;

// The eyebrow reads "How I test hypotheses fast · Claude Code & Codex". In
// the narrow rail it is set as a label plus a context line, like the
// results band, instead of wrapping with the dot at the start of a line.
const [eyebrowLabel, eyebrowContext] = c.eyebrow[locale].split(' · ');
const mergedPrsUrl = `https://github.com/${repoSlug}/pulls?q=is%3Apr+is%3Amerged`;

// Fetched at build time from the same cache as the other GitHub data. Undefined
// when GitHub is unreachable and nothing is cached; the receipt is then left out.
const mergedPrCount = await getMergedPrCount(repoSlug);
---

<section class="ed-section agent-ops" aria-labelledby="agent-ops-title">
  <div class="ed-row ed-mark">
    <div>
      <p class="ed-label">{eyebrowLabel}</p>
      {eyebrowContext && <p class="ed-context">{eyebrowContext}</p>}
    </div>
    <div class="agent-ops-body">
      <div class="agent-ops-head">
        <h2 id="agent-ops-title" class="ed-h2">{c.title[locale]}</h2>
        <p class="agent-ops-lead">{c.lead[locale]}</p>
      </div>

      <ol class="agent-steps">
        {c.steps.map((step) => (
          <li class="agent-step">
            <span class="agent-step-num" aria-hidden="true">{step.k}</span>
            <div class="agent-step-copy">
              <h3>{step.title[locale]}</h3>
              <p>{step.body[locale]}</p>
            </div>
          </li>
        ))}
      </ol>

      {/*
        The proof, as two receipt lines under the steps. The figure stays with
        its dot and "PR" on one line through the no-break spaces.
      */}
      {(mergedPrCount !== undefined || commitHash) && (
        <ul class="agent-receipts">
          {mergedPrCount !== undefined && (
            <li class="agent-receipt">
              <p class="agent-receipt-line">
                <strong class="agent-receipt-value">{mergedPrCount}</strong>&nbsp;<span class="agent-receipt-sep" aria-hidden="true">·</span>&nbsp;<span>{c.receiptPrs[locale]}</span>
              </p>
              <a class="agent-receipt-link" href={mergedPrsUrl} target="_blank" rel="noreferrer">{c.receiptPrsLink[locale]} ↗</a>
            </li>
          )}
          {commitHash && (
            <li class="agent-receipt">
              <p class="agent-receipt-line">
                <strong class="agent-receipt-value">{commitHash}</strong>&nbsp;<span class="agent-receipt-sep" aria-hidden="true">·</span>&nbsp;<span>{c.receiptDeployNote[locale]}</span>
              </p>
            </li>
          )}
        </ul>
      )}
    </div>
  </div>
</section>
