---
import { telegramUrl, uiCopy } from '../data/site-content';
import { buildIntroMailto, buildShortlistText } from '../lib/shortlist';
import type { Locale } from '../types/content';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const copy = uiCopy.home.status;

// Order is the order of a recruiter's screening call: what role, when can
// you start, where and how (time zone included), how is the English, what
// did you do last, how fast do you answer. Six on purpose: the grid is three
// columns on desktop and two on tablets, and six fills both without an orphan.
const rows = [
  { label: copy.roleLabel, value: copy.role },
  { label: copy.startLabel, value: copy.start },
  { label: copy.formatLabel, value: copy.format },
  { label: copy.englishLabel, value: copy.english },
  { label: copy.lastRoleLabel, value: copy.lastRole },
  { label: copy.repliesLabel, value: copy.replies },
];
---

{/*
  Replaces the "What I do now" block: since October 2026 there is no "now"
  job to describe, and the space under the hero is better spent answering
  the screening questions up front. The id is the hero status link target.
  data-analytics-placement lets contact clicks here be told apart from the
  identical hero and footer links.
*/}
<section
  id="status"
  class="section-block status-section"
  aria-labelledby="status-title"
  data-analytics-placement="status"
>
  <div class="section-head">
    <p class="about-eyebrow">{copy.eyebrow[locale]}</p>
    <h2 id="status-title">{copy.title[locale]}</h2>
  </div>

  <dl class="status-grid">
    {rows.map((row) => (
      <div class="status-item">
        <dt>{row.label[locale]}</dt>
        <dd>{row.value[locale]}</dd>
      </div>
    ))}
  </dl>

  <div class="status-actions" role="group" aria-label={copy.actionsAria[locale]}>
    <a class="cta-button cta-primary" href={telegramUrl} target="_blank" rel="noreferrer">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M4 11l16 -8l-4 18l-5 -4l-3 3l1 -5l8 -7" />
      </svg>
      {copy.telegram[locale]}
    </a>
    <a class="cta-button cta-secondary" href={buildIntroMailto(locale)}>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" />
      </svg>
      {copy.email[locale]}
    </a>
    {/* Ships hidden: with no way to copy it would look live and do nothing,
        and without JS it cannot work at all. The text is in the attribute,
        not fetched, so it works offline and is exactly what was built. */}
    <button
      type="button"
      class="status-copy"
      data-shortlist-copy={buildShortlistText(locale)}
      hidden
    >
      <svg class="status-copy-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="8" y="8" width="12" height="12" rx="2" /><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2" />
      </svg>
      <svg class="status-copy-done" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5" />
      </svg>
      <span>{copy.copy[locale]}</span>
    </button>
  </div>
  <p
    class="status-copy-note"
    data-shortlist-note
    aria-live="polite"
    data-copied-text={copy.copied[locale]}
    data-failed-text={copy.copyFailed[locale]}
  ></p>
</section>

<script>
  // Bundled, so it is evaluated once per ClientRouter session; the buttons
  // are re-queried on every astro:page-load because a soft navigation swaps
  // in new DOM. dataset.bound stops a double listener if the same node ever
  // survives a swap.
  // In-app browsers (Telegram's, where a lot of recruiter links get opened)
  // can refuse the async clipboard API even on a real click. The legacy
  // selection copy still works there, so it is the fallback, not an error.
  // Typed locally: execCommand is deprecated in lib.dom, and the deprecation
  // is the point here, so it is not worth a hint on every check run.
  const legacyDocument = document as unknown as { execCommand?: (command: 'copy') => boolean };

  const legacyCopy = (value: string): boolean => {
    // select() moves focus into the temporary textarea and remove() then
    // drops it to <body>, so a keyboard or screen-reader user would lose
    // their place exactly in the browsers this fallback exists for.
    const previous = document.activeElement instanceof HTMLElement ? document.activeElement : null;
    const area = document.createElement('textarea');
    area.value = value;
    area.setAttribute('readonly', '');
    area.style.position = 'fixed';
    area.style.opacity = '0';
    document.body.append(area);
    area.select();
    let ok = false;
    try {
      ok = legacyDocument.execCommand?.('copy') ?? false;
    } catch {
      ok = false;
    }
    area.remove();
    previous?.focus({ preventScroll: true });
    return ok;
  };

  const copyText = async (value: string): Promise<boolean> => {
    try {
      await navigator.clipboard.writeText(value);
      return true;
    } catch {
      return legacyCopy(value);
    }
  };

  const init = () => {
    if (!navigator.clipboard?.writeText && typeof legacyDocument.execCommand !== 'function') return;

    document.querySelectorAll<HTMLButtonElement>('[data-shortlist-copy]').forEach((button) => {
      if (button.dataset.bound) return;
      button.dataset.bound = 'true';
      button.hidden = false;

      const note = button.closest('section')?.querySelector<HTMLElement>('[data-shortlist-note]');
      let timer: number | undefined;

      button.addEventListener('click', async () => {
        const value = button.dataset.shortlistCopy;
        if (!value) return;

        const copied = await copyText(value);
        if (copied) button.dataset.copied = 'true';
        if (note) note.textContent = (copied ? note.dataset.copiedText : note.dataset.failedText) ?? '';
        window.clearTimeout(timer);
        timer = window.setTimeout(() => {
          delete button.dataset.copied;
          if (note) note.textContent = '';
        }, 4000);
      });
    });
  };

  document.addEventListener('astro:page-load', init);
</script>

<style>
  /* The hero status line links here. Above 720px the header is sticky
     (about 68px), and without a margin the eyebrow and half the heading
     land underneath it. Below 720px the header scrolls away, so no margin. */
  .status-section {
    scroll-margin-top: 5rem;
  }

  @media (max-width: 720px) {
    .status-section {
      scroll-margin-top: 0;
    }
  }

  .status-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: 1.5rem;
    margin: 0;
    border-top: 1px solid var(--border);
  }

  @media (max-width: 980px) {
    .status-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .status-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  .status-item {
    display: grid;
    align-content: start;
    gap: 0.45rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--border);
  }

  .status-item dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--foreground) 60%, transparent);
  }

  .status-item dd {
    margin: 0;
    font-size: 0.98rem;
    line-height: 1.45;
    color: var(--foreground);
    text-wrap: pretty;
  }

  .status-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .status-actions .cta-button {
    min-height: 2.75rem;
    height: auto;
    padding: 0.75rem 1.1rem;
    border-radius: 0.75rem;
    line-height: 1.2;
  }

  .status-copy {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.75rem 0.4rem;
    border: 0;
    background: none;
    color: color-mix(in oklab, var(--foreground) 72%, transparent);
    font: inherit;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: color-mix(in oklab, var(--foreground) 25%, transparent);
    text-underline-offset: 0.25em;
    transition: color var(--dur-fast) var(--ease-out-strong);
  }

  .status-copy[hidden] {
    display: none;
  }

  .status-copy svg {
    width: 1.05rem;
    height: 1.05rem;
    flex: none;
  }

  .status-copy-done,
  .status-copy[data-copied] .status-copy-icon {
    display: none;
  }

  .status-copy[data-copied] .status-copy-done {
    display: block;
    color: var(--accent-text);
  }

  @media (hover: hover) and (pointer: fine) {
    .status-copy:hover {
      color: var(--accent-text);
    }
  }

  .status-copy-note {
    min-height: 1.4em;
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--accent-text);
  }

  @media (max-width: 480px) {
    .status-actions .cta-button {
      flex: 1 1 auto;
      justify-content: center;
    }
  }

  @media print {
    .status-actions,
    .status-copy-note {
      display: none;
    }
  }
</style>
