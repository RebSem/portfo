---
// Prominent "try the live product" CTA for the Zvonobot AI case study.
// A card-style block with a headline, a sub-line, and the site's primary button
// that opens the live client cabinet, where a visitor can register themselves.
// It takes the site's card border, radius and surface and the shared CTA
// classes, so it reads as part of the page rather than an ad slot.
interface Props {
  href: string;
  eyebrow: string; // small label above the title, e.g. "Live product"
  title: string; // headline, e.g. "The cabinet is live, try it yourself"
  body: string; // one-line description under the title
  cta: string; // button label, e.g. "Open the cabinet"
  urlLabel?: string; // the human-readable URL shown next to the button
  secondaryHref?: string; // optional second link, e.g. the public landing page
  secondaryLabel?: string; // its visible text, e.g. "Лендинг продукта: zvonobot.ru/ai-agent"
}

const { href, eyebrow, title, body, cta, urlLabel, secondaryHref, secondaryLabel } = Astro.props;
---

<aside class="live-cabinet">
  <div class="live-cabinet__body">
    <span class="live-cabinet__eyebrow">
      <span class="live-cabinet__dot" aria-hidden="true"></span>
      {eyebrow}
    </span>
    <h3 class="live-cabinet__title">{title}</h3>
    <p class="live-cabinet__text">{body}</p>
  </div>
  <div class="live-cabinet__action">
    <a class="cta-button cta-primary" href={href} target="_blank" rel="noopener noreferrer">
      <span>{cta}</span>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
    {urlLabel && <span class="live-cabinet__url">{urlLabel}</span>}
    {secondaryHref && secondaryLabel && (
      <a class="live-cabinet__secondary" href={secondaryHref} target="_blank" rel="noopener noreferrer">
        {secondaryLabel}
      </a>
    )}
  </div>
</aside>

<style>
  .live-cabinet {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin: 2.2rem 0;
    padding: 1.5rem 1.65rem;
    border: 1px solid color-mix(in oklab, var(--accent) 22%, var(--border));
    border-radius: 1rem;
    background: color-mix(in oklab, var(--accent) 5%, var(--surface));
    box-shadow: none;
  }

  .live-cabinet__body {
    min-width: min(100%, 18rem);
    flex: 1 1 22rem;
  }

  .live-cabinet__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .live-cabinet__dot {
    width: 7px;
    height: 7px;
    border-radius: 999px;
    background: var(--accent);
  }

  .live-cabinet__title {
    margin: 0.55rem 0 0;
    font-size: clamp(1.1rem, 2.6vw, 1.3rem);
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .live-cabinet__text {
    margin: 0.4rem 0 0;
    font-size: 0.92rem;
    line-height: 1.5;
    color: color-mix(in oklab, var(--foreground) 72%, transparent);
  }

  .live-cabinet__action {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
  }

  .live-cabinet__url,
  .live-cabinet__secondary {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    letter-spacing: 0.01em;
    color: var(--text-muted);
  }

  /* The optional second destination, e.g. the public product landing. Quieter
     than the button on purpose: same block, clearly subordinate. */
  .live-cabinet__secondary {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .live-cabinet__secondary:hover,
  .live-cabinet__secondary:focus-visible {
    color: var(--accent-text);
  }
</style>
