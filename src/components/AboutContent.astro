---
import { Image } from 'astro:assets';
import heroImage from '../assets/main-hero.jpg';
import {
  aboutBlocks,
  githubUsername,
  heroDisplayName,
  heroSubtitle,
  skillGroups,
  skillItemText,
  uiCopy,
} from '../data/site-content';
import { buildContributionGrid, contributionWord } from '../lib/contribution-grid';
import { getGithubContributions } from '../lib/github';
import type { Locale } from '../types/content';
import HeroFacts from './HeroFacts.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

// Read at build time so the total and the calendar are in the HTML without
// JavaScript: link previews and LLM fetchers do not run it. No data at all leaves
// the band out rather than printing 0. GitHub lists every day of the year, so an
// empty calendar means the markup changed, not a quiet year.
const fetchedContributions = await getGithubContributions(githubUsername).catch(() => undefined);
const contributions = fetchedContributions && fetchedContributions.days.length > 0 ? fetchedContributions : undefined;
const heatmap = buildContributionGrid(contributions?.days ?? []);
const numberLocale = locale === 'ru' ? 'ru-RU' : 'en-US';
const totalLastYear = contributions?.totalLastYear ?? 0;
const totalText = totalLastYear.toLocaleString(numberLocale);
const unitText = contributionWord(totalLastYear, locale);

const copy = {
  eyebrow: { ru: 'Обо мне', en: 'About' },
  portraitAlt: { ru: 'Портрет Михаила Семенова', en: `Portrait of ${heroDisplayName.en}` },
  githubLabel: { ru: 'GitHub · за год', en: 'GitHub · last year' },
  heatmapName: { ru: 'Активность на GitHub', en: 'GitHub activity' },
  heatmapPeriod: { ru: 'за последний год', en: 'in the last year' },
  heatmapHint: {
    ru: 'Наведите на ячейку, чтобы увидеть дату и число вкладов.',
    en: 'Hover a cell to see the exact date and number of contributions.',
  },
} as const;

// The whole heatmap is one image for assistive tech: its name is the total, so
// the 371 cells are not read one by one.
const heatmapAria = `${copy.heatmapName[locale]}: ${totalText} ${unitText} ${copy.heatmapPeriod[locale]}`;
---

{/*
  One layout for both locales. The photo used to sit in a 320px rail beside
  blocks 01-02 only, so those two started 80px to the right of every block
  after them. Now the photo belongs to the page header, next to the intro,
  and every block below shares one grid: label column on the left, text on
  the right, the same edges all the way down.
*/}
<section class="about" aria-labelledby="about-title">
  <header class="about-head">
    <div class="about-head-copy">
      <p class="about-eyebrow">{copy.eyebrow[locale]}</p>
      <h1 id="about-title">{heroDisplayName[locale]}</h1>
      <p class="about-lead">{heroSubtitle[locale]}</p>
      <div class="about-facts">
        <HeroFacts locale={locale} />
      </div>
    </div>
    <div class="about-portrait">
      <Image src={heroImage} width={480} height={600} loading="eager" alt={copy.portraitAlt[locale]} />
    </div>
  </header>

  <div class="about-rows">
    {aboutBlocks.map((block) => (
      <article class="about-row">
        <div class="about-row-label">
          <p class="about-row-eyebrow">{block.eyebrow[locale]}</p>
        </div>
        <div class="about-row-body">
          <h2 class="about-row-title">{block.title[locale]}</h2>
          {block.body.map((para) => <p>{para[locale]}</p>)}
          {block.bullets && (
            <ul class="about-bullets">
              {block.bullets.map((item) => <li>{item[locale]}</li>)}
            </ul>
          )}
        </div>
      </article>
    ))}

    <section class="about-row" aria-labelledby="about-skills-title">
      <div class="about-row-label">
        <p class="about-row-eyebrow">{uiCopy.about.skillsEyebrow[locale]}</p>
      </div>
      <div class="about-row-body">
        <h2 id="about-skills-title" class="about-row-title">{uiCopy.about.skillsTitle[locale]}</h2>
        <div class="skill-groups">
          {skillGroups.map((group) => (
            <div class="skill-group">
              <p class="skill-group-label">{group.label[locale]}</p>
              <ul class="skill-chips" aria-label={group.label[locale]}>
                {group.items.map((item) => <li class="skill-chip">{skillItemText(item, locale)}</li>)}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>

  {/* Moved here from the home page. A commit calendar on the front page of a
      product manager's site read as "engineer" before anything else; beside
      "how I validate ideas" it is context, not the headline. It sits above
      the call to action, so the page still ends on the ask. The total and
      the cells are printed at build; src/scripts/github-activity.js only adds
      the hover hint. The page then ends on the closing footer. */}
  {contributions && (
    <section class="section-block github-band" aria-labelledby="github-title">
      <div class="github-inline">
        <div class="github-inline-meta">
          <span class="label">{copy.githubLabel[locale]}</span>
          <strong>{totalText}</strong>
          <span class="label" id="github-title">{unitText}</span>
          <a class="github-profile-link link" href={`https://github.com/${githubUsername}`} target="_blank" rel="noreferrer">
            github.com/{githubUsername}
          </a>
        </div>

        <div class="github-heatmap">
          {/* role="img" makes the grid one node for screen readers, named by the total;
              its cells stay out of the accessibility tree and the tab order (371 tab
              stops are hostile to keyboard users). No per-cell title: a tooltip on each
              cell is a mouse-only hint that repeats the hover line below. */}
          <div
            id="contribution-grid"
            class="contribution-grid"
            role="img"
            aria-label={heatmapAria}
            style={`--weeks: ${heatmap.weeks}`}
          >
            {heatmap.cells.map((cell) => (
              <div
                class={`contribution-cell level-${cell.level}`}
                data-date={cell.date}
                data-count={cell.count}
              ></div>
            ))}
          </div>

          <div class="heatmap-legend" aria-hidden="true">
            <span>0</span>
            <div class="legend-level level-0"></div>
            <div class="legend-level level-1"></div>
            <div class="legend-level level-2"></div>
            <div class="legend-level level-3"></div>
            <div class="legend-level level-4"></div>
            <span>max</span>
          </div>

          <p
            id="contribution-tooltip"
            class="contribution-tooltip"
            data-hint-ru={copy.heatmapHint.ru}
            data-hint-en={copy.heatmapHint.en}
          >
            {copy.heatmapHint[locale]}
          </p>
        </div>
      </div>
    </section>
  )}
</section>

<style>
  .about {
    padding-top: clamp(2rem, 4.5vw, 3.5rem);
  }

  .about-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 16rem);
    align-items: end;
    gap: clamp(1.75rem, 4vw, 4rem);
    padding-bottom: clamp(1.75rem, 3vw, 2.5rem);
  }

  .about-head h1 {
    margin-top: 0.6rem;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .about-lead {
    margin-top: 1rem;
    max-width: 40rem;
    font-size: clamp(1.05rem, 0.5vw + 0.9rem, 1.2rem);
    line-height: 1.55;
    color: color-mix(in oklab, var(--foreground) 80%, transparent);
  }

  .about-facts {
    margin-top: 1.25rem;
  }

  .about-portrait {
    justify-self: end;
    width: 100%;
  }

  .about-portrait :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: 1rem;
    border: 1px solid var(--border);
  }

  /* --- Rows: one grid for every block ---------------------------------- */

  .about-rows {
    border-top: 1px solid var(--border);
  }

  .about-row {
    display: grid;
    grid-template-columns: minmax(0, 15rem) minmax(0, 1fr);
    gap: 0.75rem clamp(1.5rem, 4vw, 4rem);
    padding: clamp(1.4rem, 2.5vw, 2rem) 0;
    border-bottom: 1px solid var(--border);
  }

  /* Row labels take the footer's rail-label tone (.ed-label in global.css),
     so "Contact" and the About rows read as one system. Green stays with the
     status, the results and the links. */
  .about-row-eyebrow {
    margin: 0;
    padding-top: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: color-mix(in oklab, var(--foreground) 70%, transparent);
  }

  .about-row-body {
    display: grid;
    gap: 0.6rem;
    max-width: 44rem;
  }

  .about-row-title {
    margin: 0;
    font-size: clamp(1.2rem, 1.6vw + 0.5rem, 1.5rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .about-row-body p {
    margin: 0;
    line-height: 1.6;
    color: color-mix(in oklab, var(--foreground) 82%, transparent);
  }

  .about-row-body .skill-groups {
    margin-top: 0.4rem;
  }

  @media (max-width: 860px) {
    .about-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .about-row-eyebrow {
      padding-top: 0;
    }
  }

  /* Phones: the portrait shrinks to a small square next to nothing, above
     the name, so the intro is on the first screen. */
  @media (max-width: 640px) {
    .about-head {
      grid-template-columns: minmax(0, 1fr);
    }

    .about-portrait {
      grid-row: 1;
      justify-self: start;
      width: 7.5rem;
    }

    .about-portrait :global(img) {
      aspect-ratio: 1;
      border-radius: 0.9rem;
    }
  }
</style>
