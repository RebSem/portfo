---
// Two-up grid for case-study screenshots. Four full-width shots in a row
// made the Zvonobot AI case 8,600px tall; side by side they read as one
// gallery, and each opens full size in the lightbox (ProjectScreenshot).
---

<div class="shot-grid">
  <slot />
</div>

<style>
  .shot-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.1rem;
    margin: 1.6rem 0;
  }

  .shot-grid :global(.project-shot) {
    margin: 0;
  }

  @media (max-width: 760px) {
    .shot-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
