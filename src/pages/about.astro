---
import AboutContent from '../components/AboutContent.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import {
  buildPersonSchema,
  githubUsername,
  heroFallbackName,
} from '../data/site-content';
import Layout from '../layouts/Layout.astro';
import githubScriptUrl from '../scripts/github-activity.js?url';

const avatarUrl = `https://avatars.githubusercontent.com/${githubUsername}?size=560`;
const personEntity = buildPersonSchema('https://rebsem.ru/about');
personEntity.image = avatarUrl;
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: 'https://rebsem.ru/about',
  name: `${heroFallbackName} - About`,
  inLanguage: 'en',
  mainEntity: personEntity,
};
---

<Layout
  title={`${heroFallbackName} - About`}
  image="/og/about-en.png"
  description="Product manager in B2B SaaS. Launched a voice AI agent line from zero at Zvonobot (Prof-IT Group): 80 paying customers and 500,000+ minutes in production in under a year. How I work, where I add the most value, and the role I am looking for now. Available to start immediately. Remote, GMT+5, open to relocation."
  schema={aboutSchema}
  alternate="/ru/about"
>
  <a id="skip-to-content" href="#main-content" class="skip-link">Skip to content</a>

  <SiteHeader active="about" />

  <main id="main-content" class="page-main">
    <AboutContent locale="en" />
  </main>

  <SiteFooter />
  <script is:inline type="module" src={githubScriptUrl}></script>
</Layout>
