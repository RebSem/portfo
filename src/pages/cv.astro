---
import CvDocument from '../components/CvDocument.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { buildEmploymentSchema, cvFileBaseName, cvName } from '../data/cv';
import { buildPersonSchema } from '../data/site-content';
import Layout from '../layouts/Layout.astro';
import cvScriptUrl from '../scripts/cv.js?url';

// Trailing slash, matching the canonical the build emits: the JSON-LD url,
// canonical and hreflang disagreed on the slash and an LLM screener reading
// raw HTML sees all three.
const pageUrl = 'https://rebsem.ru/cv/';
const pdfHref = `/cv/${cvFileBaseName.en}.pdf`;
const docxHref = `/cv/${cvFileBaseName.en}.docx`;
const txtHref = '/cv.txt';

// Unlisted, not secret: this page carries `noindex, follow` and is absent from
// the sitemap, llms.txt and the menu. Its only public links are the quiet
// "Resume" text links (nofollow) after Email on the home page and in the case
// availability strip, and the PDF, DOCX and TXT downloads are nofollow too.
// `follow` is deliberate, an LLM screener given the link has to be able to
// reach the case studies it cites.
const personEntity = buildPersonSchema(pageUrl, 'en');
// Employment history, so an LLM screener handed this link can answer
// "where did they work and when" from the structured data alone. Past jobs
// go under alumniOf: worksFor reads as a current employer, and there is none.
personEntity.alumniOf = [personEntity.alumniOf, ...buildEmploymentSchema('en')];
const cvSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: pageUrl,
  name: `${cvName.en} - CV`,
  inLanguage: 'en',
  mainEntity: personEntity,
};
---

<Layout
  title={`${cvName.en} - CV`}
  image="/og/cv-en.png"
  description="Resume: product manager in B2B SaaS and AI. A voice AI agent line from scratch to 80 paying B2B customers in under a year. Open to work now. PDF, DOCX, TXT."
  noIndex
  followLinks
  schema={cvSchema}
  alternate="/ru/cv/"
>
  <a id="skip-to-content" href="#main-content" class="skip-link">Skip to content</a>

  <SiteHeader active="cv" pdfHref={pdfHref} pdfLabel="PDF" />

  <main id="main-content" class="page-main">
    <CvDocument locale="en" pdfHref={pdfHref} docxHref={docxHref} txtHref={txtHref} />
  </main>

  <script is:inline type="module" src={cvScriptUrl}></script>
</Layout>
