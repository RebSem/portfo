---
import { getCollection } from 'astro:content';
import AgentOps from '../components/AgentOps.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import HomeHero from '../components/HomeHero.astro';
import HomeProjects from '../components/HomeProjects.astro';
import HomeResults from '../components/HomeResults.astro';
import {
  buildPersonSchema,
  githubUsername,
  heroFallbackName,
} from '../data/site-content';
import Layout from '../layouts/Layout.astro';

const projectEntries = await getCollection('projects', ({ data }) => !data.draft && data.lang === 'en');

const zvonobotEntry = projectEntries.find((e) => e.data.projectId === 'zvonobot-ai');
const zvonobotCaseHref = zvonobotEntry ? `/projects/${zvonobotEntry.id}/` : `/#projects`;

const personSchema = buildPersonSchema('https://rebsem.ru/');
---

<Layout
  title={`${heroFallbackName} - Product Manager`}
  description="Product manager in B2B SaaS, open to work and available now. Launched Zvonobot AI, a voice AI agent line, from zero: 80 paying B2B customers and 500,000+ minutes of live conversations in production in under a year. Owned pricing, unit economics and go-to-market. Remote, GMT+5, EN/RU, open to relocation."
  schema={personSchema}
  alternate="/ru/"
>
  <a id="skip-to-content" href="#main-content" class="skip-link">Skip to content</a>

  <SiteHeader active="home" />

  <main id="main-content" class="page-main" data-github-username={githubUsername}>
    <HomeHero locale="en" caseHref={zvonobotCaseHref} />
    <HomeResults locale="en" />

    <HomeProjects locale="en" />

    <AgentOps locale="en" />
  </main>

  <SiteFooter closing />
</Layout>
