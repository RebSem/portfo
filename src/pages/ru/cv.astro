---
import CvDocument from '../../components/CvDocument.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { buildEmploymentSchema, cvFileBaseName, cvName, cvSummary } from '../../data/cv';
import { buildPersonSchema } from '../../data/site-content';
import Layout from '../../layouts/Layout.astro';
import cvScriptUrl from '../../scripts/cv.js?url';

const pageUrl = 'https://rebsem.ru/ru/cv';
const pdfHref = `/cv/${cvFileBaseName.ru}.pdf`;
const docxHref = `/cv/${cvFileBaseName.ru}.docx`;
const txtHref = '/ru/cv.txt';

const personEntity = buildPersonSchema(pageUrl);
// Employment history, so an LLM screener handed this link can answer
// "where did they work and when" from the structured data alone.
personEntity.worksFor = buildEmploymentSchema('ru');
const cvSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: pageUrl,
  name: `${cvName.ru} - резюме`,
  inLanguage: 'ru',
  mainEntity: personEntity,
};
---

<Layout
  title={`${cvName.ru} - резюме`}
  image="/og/cv-ru.png"
  description={cvSummary.ru}
  noIndex
  followLinks
  schema={cvSchema}
  alternate="/cv"
>
  <a id="skip-to-content" href="#main-content" class="skip-link">К содержимому</a>

  <SiteHeader active="cv" pdfHref={pdfHref} pdfLabel="PDF" />

  <main id="main-content" class="page-main">
    <CvDocument locale="ru" pdfHref={pdfHref} docxHref={docxHref} txtHref={txtHref} />
  </main>

  <script is:inline type="module" src={cvScriptUrl}></script>
</Layout>
