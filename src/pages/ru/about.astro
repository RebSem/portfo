---
import { Image } from 'astro:assets';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import {
  aboutBlocks,
  buildPersonSchema,
  githubUsername,
  heroDisplayName,
  heroSubtitle,
  skillGroups,
  skillItemText,
  telegramUrl,
  uiCopy,
} from '../../data/site-content';
import Layout from '../../layouts/Layout.astro';
import githubScriptUrl from '../../scripts/github-activity.js?url';
import heroImage from '../../assets/main-hero.jpg';

const avatarUrl = `https://avatars.githubusercontent.com/${githubUsername}?size=560`;
// Колонка с фото занята только рядом с первыми двумя блоками; дальше страница
// перетекает в одну центрированную колонку (без пустого рельса в 320px).
const gridBlocks = aboutBlocks.slice(0, 2);
const flowBlocks = aboutBlocks.slice(2);
const personEntity = buildPersonSchema('https://rebsem.ru/ru/about');
personEntity.image = avatarUrl;
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: 'https://rebsem.ru/ru/about',
  name: `${heroDisplayName.ru} - Обо мне`,
  inLanguage: 'ru',
  mainEntity: personEntity,
};
---

<Layout
  title={`${heroDisplayName.ru} - Обо мне`}
  image="/og/about-ru.png"
  description="Продакт-менеджер в B2B SaaS. Запустил в Zvonobot (группа Prof-IT) направление голосовых AI-агентов с нуля: 80 платящих клиентов и 500 000+ минут в проде меньше чем за год. Как работаю, где полезен сильнее всего и к каким ролям открыт. Удалённо, GMT+5, готов к релокации."
  schema={aboutSchema}
  alternate="/about"
>
  <a id="skip-to-content" href="#main-content" class="skip-link">Перейти к содержимому</a>

  <SiteHeader active="about" />

  <main
    id="main-content"
    class="page-main"
  >
    <section class="about-section" aria-labelledby="about-title">
      <p class="about-eyebrow">Обо мне</p>

      <h1 id="about-title">
        <span id="hero-name">{heroDisplayName.ru}</span>
      </h1>

      <p class="about-intro">{heroSubtitle.ru}</p>

      <div class="about-grid">
        <div class="about-image-wrap">
          <Image
            id="hero-avatar"
            src={heroImage}
            width={560}
            height={700}
            loading="eager"
            alt="Портрет Михаила Семенова"
          />
        </div>

        <div class="about-copy">
          <div class="about-blocks">
            {gridBlocks.map((block) => (
              <article class="about-block">
                <p class="about-block-eyebrow">{block.eyebrow.ru}</p>
                <h2 class="about-block-title">{block.title.ru}</h2>
                {block.body.map((para) => (<p>{para.ru}</p>))}
                {block.bullets && (
                  <ul class="about-bullets">
                    {block.bullets.map((item) => (<li>{item.ru}</li>))}
                  </ul>
                )}
              </article>
            ))}
          </div>
        </div>
      </div>

      <div class="about-flow">
        <div class="about-blocks">
          {flowBlocks.map((block) => (
            <article class="about-block">
              <p class="about-block-eyebrow">{block.eyebrow.ru}</p>
              <h2 class="about-block-title">{block.title.ru}</h2>
              {block.body.map((para) => (<p>{para.ru}</p>))}
              {block.bullets && (
                <ul class="about-bullets">
                  {block.bullets.map((item) => (<li>{item.ru}</li>))}
                </ul>
              )}
            </article>
          ))}
        </div>

        <section class="about-skills" aria-labelledby="about-skills-title">
            <p class="about-block-eyebrow">{uiCopy.about.skillsEyebrow.ru}</p>
            <h2 id="about-skills-title" class="about-block-title">{uiCopy.about.skillsTitle.ru}</h2>
            <p class="about-skills-note">{uiCopy.about.skillsNote.ru}</p>
            <div class="skill-groups">
              {skillGroups.map((group) => (
                <div class="skill-group">
                  <p class="skill-group-label">{group.label.ru}</p>
                  <ul class="skill-chips" aria-label={group.label.ru}>
                    {group.items.map((item) => (<li class="skill-chip">{skillItemText(item, 'ru')}</li>))}
                  </ul>
                </div>
              ))}
            </div>
          </section>

        <div class="about-cta-card">
          <p class="about-cta-eyebrow">Связаться</p>
          <p class="about-cta-headline">Открыт к ролям продакт-менеджера в B2B SaaS, платежах и AI-продуктах.</p>
          <p class="about-cta-sub">Расскажите про продукт и задачу. Скажу честно, подхожу ли я, и где AI реально даст результат, а где нет.</p>
          <div class="about-cta-row">
            <a class="cta-button cta-primary" href={telegramUrl} target="_blank" rel="noreferrer">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M4 11l16 -8l-4 18l-5 -4l-3 3l1 -5l8 -7"/>
              </svg>
              {uiCopy.home.heroCtaPrimary.ru}
            </a>
          </div>
        </div>
      </div>
    </section>

    {/* Moved here from the home page. A commit calendar on the front page of a
        product manager's site read as "engineer" before anything else; beside
        "how I validate ideas" it is context, not the headline. */}
    <section class="section-block github-band" aria-labelledby="github-title">
      <div class="github-inline">
        <div class="github-inline-meta">
          <span class="label">GitHub · за год</span>
          <strong id="contributions-total">0</strong>
          <span class="label" id="github-title">вкладов</span>
          <a
            class="github-profile-link link"
            href={`https://github.com/${githubUsername}`}
            target="_blank"
            rel="noreferrer"
          >
            github.com/{githubUsername}
          </a>
        </div>

        <div class="github-heatmap">
          <div
            id="contribution-grid"
            class="contribution-grid"
            role="group"
            aria-label="График активности GitHub"
          ></div>

          <div class="heatmap-legend" aria-hidden="true">
            <span>0</span>
            <div class="legend-level level-0"></div>
            <div class="legend-level level-1"></div>
            <div class="legend-level level-2"></div>
            <div class="legend-level level-3"></div>
            <div class="legend-level level-4"></div>
            <span>max</span>
          </div>

          <p
            id="contribution-tooltip"
            class="contribution-tooltip"
            data-hint-ru="Наведите на ячейку, чтобы увидеть дату и число вкладов."
            data-hint-en="Hover a cell to see the exact date and number of contributions."
          >
            Наведите на ячейку, чтобы увидеть дату и число вкладов.
          </p>

          <p id="github-error" class="github-error hidden">
            Не удалось загрузить GitHub-данные. Попробуйте обновить страницу позже.
          </p>
        </div>
      </div>
    </section>
  </main>

  <SiteFooter />
  <script is:inline type="module" src={githubScriptUrl}></script>
</Layout>
