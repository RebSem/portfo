---
import AboutContent from '../../components/AboutContent.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import {
  buildPersonSchema,
  githubUsername,
  heroDisplayName,
} from '../../data/site-content';
import Layout from '../../layouts/Layout.astro';
import githubScriptUrl from '../../scripts/github-activity.js?url';

const avatarUrl = `https://avatars.githubusercontent.com/${githubUsername}?size=560`;
const personEntity = buildPersonSchema('https://rebsem.ru/ru/about');
personEntity.image = avatarUrl;
const aboutSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  url: 'https://rebsem.ru/ru/about',
  name: `${heroDisplayName.ru} - Обо мне`,
  inLanguage: 'ru',
  mainEntity: personEntity,
};
---

<Layout
  title={`${heroDisplayName.ru} - Обо мне`}
  image="/og/about-ru.png"
  description="Продакт-менеджер в B2B SaaS. Запустил в Zvonobot (группа Prof-IT) направление голосовых AI-агентов с нуля: 80 платящих клиентов и 500 000+ минут в проде меньше чем за год. Как работаю, где полезен сильнее всего и какую роль ищу сейчас. Готов выйти сразу. Удалённо, GMT+5, готов к релокации."
  schema={aboutSchema}
  alternate="/about"
>
  <a id="skip-to-content" href="#main-content" class="skip-link">Перейти к содержимому</a>

  <SiteHeader active="about" />

  <main id="main-content" class="page-main">
    <AboutContent locale="ru" />
  </main>

  <SiteFooter />
  <script is:inline type="module" src={githubScriptUrl}></script>
</Layout>
