---
import { getCollection, render } from 'astro:content';
import CaseAvailability from '../../../components/CaseAvailability.astro';
import CaseNext from '../../../components/CaseNext.astro';
import SiteFooter from '../../../components/SiteFooter.astro';
import SiteHeader from '../../../components/SiteHeader.astro';
import { projects } from '../../../data/projects';
import { githubUsername, heroDisplayName, linkedinUrl, personSchemaId, telegramUrl } from '../../../data/site-content';
import { nextCaseProjectId } from '../../../lib/case-order';
import { chunks, HYPHENATED } from '../../../lib/nb';
import Layout from '../../../layouts/Layout.astro';
import caseLinksScriptUrl from '../../../scripts/case-links.js?url';

export async function getStaticPaths() {
  const projectEntries = await getCollection('projects', ({ data }) => !data.draft && data.lang === 'ru');
  return projectEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

// Find English version for switcher
const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const enSlug = allProjects.find((p) => p.data.projectId === entry.data.projectId && p.data.lang === 'en')?.id;

// The next case in the loop (src/lib/case-order.ts), in this locale.
const nextId = nextCaseProjectId(entry.data.projectId);
const nextEntry = allProjects.find((p) => p.data.projectId === nextId && p.data.lang === 'ru');
const nextProject = projects.find((p) => p.id === nextId);

const pageImage = entry.data.cover ?? '/og/home-ru.png';
const projectSchema = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: entry.data.title,
  description: entry.data.description,
  inLanguage: 'ru',
  image: pageImage.startsWith('http://') || pageImage.startsWith('https://')
    ? pageImage
    : `https://rebsem.ru${pageImage}`,
  url: `https://rebsem.ru/ru/projects/${entry.id}/`,
  author: {
    '@id': personSchemaId,
    '@type': 'Person',
    name: heroDisplayName.en,
    alternateName: heroDisplayName.ru,
    sameAs: [
      `https://github.com/${githubUsername}`,
      telegramUrl,
      linkedinUrl,
    ],
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://rebsem.ru/ru/' },
    { '@type': 'ListItem', position: 2, name: entry.data.title, item: `https://rebsem.ru/ru/projects/${entry.id}/` },
  ],
};
---

<Layout
  title={`${entry.data.title} · ${heroDisplayName.ru}`}
  description={entry.data.description}
  image={pageImage}
  schema={[projectSchema, breadcrumbSchema]}
  alternate={enSlug ? `/projects/${enSlug}/` : undefined}
>
  <a id="skip-to-content" href="#main-content" class="skip-link">Перейти к содержимому</a>

  <SiteHeader active="home" localeToggleUrl={enSlug ? `/projects/${enSlug}/` : undefined} />

  <div class="divider-wrap" aria-hidden="true">
    <hr class="divider" />
  </div>

  <main
    id="main-content"
    class="page-main"
    data-post-slug-en={enSlug ?? ''}
  >
    <article class="post-shell">
      <p>
        <a class="case-back" href="/ru/#projects">← Все проекты</a>
      </p>

      <header class="post-head">
        <h1>{chunks(entry.data.title).map((c) => (HYPHENATED.test(c) ? <span class="nb">{c}</span> : c))}</h1>
        <p class="post-lead">{chunks(entry.data.description).map((c) => (HYPHENATED.test(c) ? <span class="nb">{c}</span> : c))}</p>
      </header>

      {(entry.data.role || entry.data.timeline || entry.data.repoUrl) && (
        <div class="project-quick-facts">
          {entry.data.role && (
            <div class="fact-item">
              <span class="fact-label">Роль</span>
              <span class="fact-value">{entry.data.role}</span>
            </div>
          )}
          {entry.data.timeline && (
            <div class="fact-item">
              <span class="fact-label">Сроки</span>
              <span class="fact-value">{entry.data.timeline}</span>
            </div>
          )}
          {entry.data.repoUrl && (
            <div class="fact-item">
              <span class="fact-label">Репозиторий</span>
              <span class="fact-value">
                <a href={entry.data.repoUrl} target="_blank" rel="noopener noreferrer" data-project-link="repo">
                  {entry.data.repoUrl.replace('https://github.com/', '')}
                </a>
              </span>
            </div>
          )}
        </div>
      )}


      <CaseAvailability locale="ru" />

      <div class="prose">
        <Content />
      </div>

      {entry.data.tags.length > 0 && (
        <ul class="case-tags" aria-label="Технологии проекта">
          {entry.data.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )}
    </article>

    {nextEntry && nextProject && (
      <CaseNext
        locale="ru"
        href={`/ru/projects/${nextEntry.id}/`}
        title={nextProject.title.ru}
        summary={nextProject.summary.ru}
      />
    )}
  </main>

  <SiteFooter closing rail={false} />
  <script is:inline type="module" src={caseLinksScriptUrl}></script>
</Layout>
