---
import { getCollection } from 'astro:content';
import AgentOps from '../../components/AgentOps.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import HomeHero from '../../components/HomeHero.astro';
import HomeProjects from '../../components/HomeProjects.astro';
import {
  buildPersonSchema,
  githubUsername,
  heroDisplayName,
} from '../../data/site-content';
import Layout from '../../layouts/Layout.astro';

const projectEntries = await getCollection('projects', ({ data }) => !data.draft && data.lang === 'ru');

const zvonobotEntry = projectEntries.find((e) => e.data.projectId === 'zvonobot-ai');
const zvonobotCaseHref = zvonobotEntry ? `/ru/projects/${zvonobotEntry.slug}/` : `/ru/#projects`;

const personSchema = buildPersonSchema('https://rebsem.ru/ru');
---

<Layout
  title={`${heroDisplayName.ru} - Product Manager`}
  description="Продакт-менеджер в B2B SaaS, ищу работу и готов выйти сразу. Запустил в Zvonobot направление голосовых AI-агентов с нуля: 80 платящих B2B-клиентов и 500 000+ минут живых разговоров в проде меньше чем за год. Отвечал за прайсинг, юнит-экономику и вывод на рынок. Удалённо, GMT+5, EN/RU, готов к релокации."
  schema={personSchema}
  alternate="/"
>
  <a id="skip-to-content" href="#main-content" class="skip-link">Перейти к содержимому</a>

  <SiteHeader active="home" />

  <main id="main-content" class="page-main" data-github-username={githubUsername}>
    <HomeHero locale="ru" caseHref={zvonobotCaseHref} />

    <HomeProjects locale="ru" />

    <AgentOps locale="ru" />
  </main>

  <SiteFooter />
</Layout>
