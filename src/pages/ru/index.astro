---
import { getCollection } from 'astro:content';
import AgentOps from '../../components/AgentOps.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import HomeHero from '../../components/HomeHero.astro';
import HomeProjects from '../../components/HomeProjects.astro';
import HomeResults from '../../components/HomeResults.astro';
import {
  buildPersonSchema,
  buildWebSiteSchema,
  githubUsername,
  heroDisplayName,
} from '../../data/site-content';
import Layout from '../../layouts/Layout.astro';

const projectEntries = await getCollection('projects', ({ data }) => !data.draft && data.lang === 'ru');

const zvonobotEntry = projectEntries.find((e) => e.data.projectId === 'zvonobot-ai');
const zvonobotCaseHref = zvonobotEntry ? `/ru/projects/${zvonobotEntry.id}/` : `/ru/#projects`;

const personSchema = buildPersonSchema('https://rebsem.ru/ru/', 'ru');
const websiteSchema = buildWebSiteSchema();
---

<Layout
  title={`${heroDisplayName.ru} - Product Manager`}
  description="Продакт-менеджер, B2B SaaS и AI. Запустил с нуля направление голосовых AI-агентов: 80 платящих B2B-клиентов меньше чем за год. Ищу работу. Удалённо, GMT+5."
  schema={[personSchema, websiteSchema]}
  alternate="/"
>
  <a id="skip-to-content" href="#main-content" class="skip-link">Перейти к содержимому</a>

  <SiteHeader active="home" />

  <main id="main-content" class="page-main" data-github-username={githubUsername}>
    <HomeHero locale="ru" caseHref={zvonobotCaseHref} />
    <HomeResults locale="ru" />

    <HomeProjects locale="ru" />

    <AgentOps locale="ru" />
  </main>

  <SiteFooter closing />
</Layout>
